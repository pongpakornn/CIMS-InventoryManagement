<Window x:Class="CIMS.Views.MainView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:CIMS.Converters"
            xmlns:helpers="clr-namespace:CIMS.Helpers"
            Title="CIMS - CHR Inventory Management System" Height="800" Width="1400" MinWidth="960" MinHeight="600" SizeChanged="MainView_SizeChanged"
            Background="{StaticResource BgLight}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>



        <!-- Function Sidebar : Container -->
        <Border x:Name="SidebarContainer" Grid.Column="0" Width="260" Background="{StaticResource PrimaryColor}">
            <Border.Resources>
                <Style x:Key="SidebarIconStyle" TargetType="Image">
                    <Setter Property="Width" Value="34"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                    <Setter Property="Margin" Value="-2,0,0,0"/>
                </Style>

                <Style x:Key="SidebarTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="6,5,0,0"/>
                    <Setter Property="Visibility" Value="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Style>

                <Style x:Key="DropdownStatusStyle" TargetType="Ellipse">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Margin" Value="7,0,10,0"/>
                </Style>


            </Border.Resources>


            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <Border Height="60" Background="{StaticResource PrimaryDark}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Border Background="{StaticResource AccentColor}">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/CIMS.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <!-- ชื่อระบบ: CIMS (ตัวย่อ) + ชื่อเต็มบรรทัดเล็ก -->
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="CIMS" FontWeight="ExtraBold" Foreground="White" FontSize="18"/>
                                <TextBlock Text="CHR Inventory Management System" FontWeight="SemiBold" Foreground="#AAAAAA" FontSize="9" Margin="1,-1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Function Button : Dashboard -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnDashboard_Click" Margin="5,4,0,0" Visibility="{Binding CurrentUser.CanViewDashboard, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="30" Height="30" Source="/Assets/Icons/Dashboard.png" Style="{StaticResource SidebarIconStyle}"  Margin="-1,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : Store ( Max - Min ) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnStore_Click" Margin="5,4,0,0" Visibility="{Binding CurrentUser.CanViewStore, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="35" Height="32" Source="/Assets/Icons/StoreMaxMin.png" Style="{StaticResource SidebarIconStyle}"/>
                            <TextBlock Grid.Column="1" Text="Store ( Max - Min )" Style="{StaticResource SidebarTextStyle}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->


                    <!-- Function Button : Multi-Scanner (หน้าเดียว: เริ่มที่สแกนรับเข้า, สลับสแกนออกได้ที่ปุ่มในหน้า) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnMultiScanner_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewScannerMenu, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Left" Margin="12,0,0,0">
                                <Path Fill="White" Data="M2 4h2v16H2z M5 4h1v16H5z M7 4h3v16H7z M11 4h1v16h-1z M13 4h2v16h-2z M16 4h1v16h-1z M18 4h3v16h-3z M22 4h1v16h-1z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Multi-Scanner" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : Product Control -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnProductControl_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewProductControl, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Icons/registration.png" Style="{StaticResource SidebarIconStyle}" Margin="1,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Inventory Registration" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : Pick List (เดิมชื่อ Packing Card) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnPackingCard_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewPackingCard, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Left" Margin="12,0,0,0">
                                <Path Fill="White" Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Pick List" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Product Control -->
                    <!--<Button Style="{StaticResource SidebarButtonStyle}" Margin="0,5,0,0" Click="btnProductControls_Click">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/Icons/ProductControl.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Margin="2,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="PRODUCT CONTROL" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Black" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource SidebarTextStyle}"/>
                            </Grid>
                        </Button>-->

                    <!-- Function Button : Max-Min Calculator (ย้ายมาจาก StorePC) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnMaxMinCalc_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewMaxMinCalc, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="32" Height="32" Source="/Assets/Icons/CalculatorMxMn.png" Style="{StaticResource SidebarIconStyle}"/>
                            <TextBlock Grid.Column="1" Text="Max-Min Calculator" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : Forecast / Order / Delivery (กราฟ + TOP 5 + ตาราง / Import / Export) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnForecastOrder_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewForecastOrder, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="32" Height="32" Source="/Assets/Icons/ForecastOrder.png" Style="{StaticResource SidebarIconStyle}"/>
                            <TextBlock Grid.Column="1" Text="Forecast / Order" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : PR (เปิดใช้งานแล้ว - เห็นได้กลุ่มเดียวกับเมนู Store) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnPR_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewPR, Converter={StaticResource BoolToVis}}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Assets/Icons/PR.png" Style="{StaticResource SidebarIconStyle}" Margin="1,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="PR Management" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Button>
                    <!-- End Function -->

                    <!-- Function Button : Activity Log (การเคลื่อนไหวของผู้ใช้งานทั้งระบบ) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnActivityLog_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewActivityLog, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="32" Height="32" Source="/Assets/Icons/historyscanner.png" Style="{StaticResource SidebarIconStyle}"/>
                            <TextBlock Grid.Column="1" Text="Activity Log" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : User Management (ผู้ใช้งาน + สิทธิ์ทุกระบบ) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnUserMgmt_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewUserMgmt, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="30" Height="30" Source="/Assets/Icons/management.png" Style="{StaticResource SidebarIconStyle}"/>
                            <TextBlock Grid.Column="1" Text="User Management" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->


                    <!-- Function Button : ManageUser -->
                    <!--<Button Style="{StaticResource SidebarButtonStyle}" 
                            Click="BtnManageUser_Click" 
                            Margin="0,5,0,0">
                            <Button.Visibility>
                                <Binding Path="CurrentUser.UserLevel" 
                                 Converter="{StaticResource PermissionToVisibilityConverter}" 
                                 ConverterParameter="1" />
                            </Button.Visibility>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" 
                                   Source="/Assets/Icons/management.png" 
                                   Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="1" 
                                   Text="Manage User" 
                                   Style="{StaticResource SidebarTextStyle}"/>
                            </Grid>
                        </Button>-->
                    <!-- End Function -->

                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,15">
                    <TextBlock FontSize="10" Foreground="#66FFFFFF" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="P.U."/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                        <Setter Property="Text" Value="© 2026 CIMS • Pongpakorn Urang"/>
                                        <Setter Property="FontWeight" Value="Light"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- เวอร์ชันโปรแกรมที่ติดตั้ง (ClickOnce) -->
                    <TextBlock x:Name="txtAppVersion" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- End Sidebar : Container -->


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="20,0">
                <Grid>

                    <!-- Function : Menu Sidebar Open-Close -->
                    <Button Content="☰" Foreground="White" Background="Transparent" BorderThickness="0" 
                                FontSize="22" HorizontalAlignment="Left" Click="btnToggleSidebar_Click" Cursor="Hand"/>
                    <!-- End : Menu Sidebar Open-Close -->

                    <!-- Function TextBlock : STORE ( MAX - MIN ) -->
                    <TextBlock x:Name="txtPageTitle" Text="STORE ( MAX - MIN )" Foreground="White" 
                                   FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- End : STORE ( MAX - MIN ) -->

                    <!-- Function TextBlock : Name: Password: -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="{Binding CurrentUser.UserName}"
                                     Foreground="White" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentUser.UserId, StringFormat='EmpID: {0}'}"
                                     FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                        </StackPanel>

                        <!-- Function Icon : Profile -->
                        <Ellipse Width="42" Height="42" Margin="0,0,20,0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/Icons/user.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- End : Profile -->


                        <!-- Function Icon : LogOut -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" 
                               Click="Logout_Click" VerticalAlignment="Center">
                            <Grid Width="35" Height="35" Opacity="0.7">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Border Background="White">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/64logout_FF.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                        </Button>
                        <!-- End : LogOut -->



                    </StackPanel>
                </Grid>
            </Border>

            <!-- 📐 Responsive: ทุกหน้าออกแบบไว้สำหรับพื้นที่กว้างอย่างน้อย DesignWidth (MainView.xaml.cs)
                 จอเล็กกว่านั้น -> จัดหน้าที่ขนาดเดิมแล้วย่อทั้งหน้าให้พอดีจอ (เหมือนซูม เลย์เอาต์ไม่เพี้ยน)
                 ย่อได้ไม่ต่ำกว่า MinScale (ตัวหนังสือยังอ่านได้) เล็กกว่านั้นเลื่อนดูได้ -->
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Focusable="False" SizeChanged="PageScroll_SizeChanged">
                <Grid x:Name="PageHost" RequestBringIntoView="PageHost_RequestBringIntoView">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="15"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>