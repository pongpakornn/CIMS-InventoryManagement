<Window x:Class="CIMS.Views.LoginView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:CIMS.Views"
            mc:Ignorable="d"
            Title="CIMS - Login" Height="480" Width="390" 
            WindowStyle="None" AllowsTransparency="True" Background="Transparent"
            WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
            MouseDown="Window_MouseDown">

    <Window.Resources>

        
        
        <!-- Style : Effects Muti-Trigger to Textbox -->
        <Style x:Key="ModernInputStyle" TargetType="Control">
            <Setter Property="Background" Value="#2B2A2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                        CornerRadius="12" BorderThickness="1.5" BorderBrush="#00FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glowEffect" BlurRadius="15" Color="#FFFFFF" Opacity="0" ShadowDepth="0"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="(Border.Effect).Opacity"
                                                     To="0.3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="(Border.Effect).Opacity"
                                                     To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="(Border.Effect).Opacity"
                                                     To="0.6" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="(Border.Effect).BlurRadius"
                                                     To="20" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="(Border.Effect).Opacity"
                                                     To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsFocused" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Border.Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" Color="#FFFFFF" Opacity="0.7" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        

        <Style x:Key="AnimatedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20" Margin="0,0,10,0">
                                <Border x:Name="box" 
                                Background="White" 
                                BorderBrush="#d9d9d9" 
                                BorderThickness="1" 
                                CornerRadius="5">
                                    <Grid>
                                        <Border x:Name="ripple" 
                                        BorderBrush="#1677ff" 
                                        BorderThickness="8" 
                                        CornerRadius="5" 
                                        Opacity="0" 
                                        RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>

                                        <Path x:Name="checkmark" 
                                      Data="M 6 10 L 9 13 L 15 7" 
                                      Stroke="White" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      Stretch="Uniform" 
                                      Width="12" Height="12"
                                      RenderTransformOrigin="0.5,0.5"
                                      Opacity="0">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="0" ScaleY="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>
                            </Grid>

                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#1677ff"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#1677ff"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="checkmark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="checkmark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="1.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="checkmark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="1.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="checkmark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="checkmark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="checkmark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ripple" Storyboard.TargetProperty="Opacity" From="0.4" To="0" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="ripple" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.5" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="ripple" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.5" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" Margin="15">
        <Border.Background>
            <SolidColorBrush Color="#1A191D" Opacity="0.9"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
            Margin="0,20,20,0" Width="30" Height="30" Cursor="Hand" Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" x:Name="container" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Border x:Name="hoverCircle" 
                            Background="#FF4C4C" 
                            CornerRadius="15" 
                            RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                </Border.RenderTransform>
                            </Border>

                            <Border x:Name="exitCircle" Background="#3D3C42" CornerRadius="15">
                                <TextBlock x:Name="xText" Text="✕" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverCircle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="hoverCircle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="container" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="container" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.3"/>
                                            <ColorAnimation Storyboard.TargetName="exitCircle" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF4C4C" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverCircle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="hoverCircle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="container" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="container" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/>
                                            <ColorAnimation Storyboard.TargetName="exitCircle" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3D3C42" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="xText" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="container" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel VerticalAlignment="Center" Margin="40,0">
                <TextBlock Text="CIMS" Foreground="White" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" Color="#6C63FF" Opacity="0.5" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="CHR Inventory Management System" Foreground="#B8B4D8" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,21"/>

                <TextBlock Text="Username" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="5,0,0,8"/>
                <TextBox x:Name="txt_Username" Height="45" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,20" KeyDown="txt_Username_KeyDown"/>

                <TextBlock Text="Password" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="5,0,0,8" />
                <PasswordBox x:Name="txt_Password" Height="45" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15" KeyDown="txt_Password_KeyDown" />

                <CheckBox Content="Remember me" Style="{StaticResource AnimatedCheckBox}" FontWeight="Bold" Foreground="#FFFFFF" Margin="5,0,0,30" x:Name="chk_Remember"/>

                <Button Content="LOGIN" Height="45" Width="180" Cursor="Hand" Click="Login_Click" Margin="0,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#222"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Border x:Name="btnAfter" Background="White" CornerRadius="22.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="btnBase" Background="{TemplateBinding Background}" CornerRadius="22.5" BorderBrush="#EEE" BorderThickness="1">
                                                <Grid x:Name="contentGrid" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform Y="0"/>
                                                    </Grid.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBase" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.15" ShadowDepth="6"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="contentGrid" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="-2.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="btnAfter" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:0.5"/>
                                                            <DoubleAnimation Storyboard.TargetName="btnAfter" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.3" Duration="0:0:0.5">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="btnAfter" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.5" Duration="0:0:0.5">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="contentGrid" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="-0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="btnBase" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.1" ShadowDepth="2"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>
        
        
    </Border>
    
</Window>