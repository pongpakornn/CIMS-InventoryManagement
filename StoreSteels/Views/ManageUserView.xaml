<Page x:Class="CIMS.Views.ManageUserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Management" Background="Transparent"
      RenderTransformOrigin="0.5,0.5">

    <Page.Resources>
        <!-- MintGreen is page-specific: ProductControlView.xaml uses the same key name for a
             different color (#2DFFB4), so it is intentionally not centralized. -->
        <SolidColorBrush x:Key="MintGreen" Color="#4CAF50"/>

        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                CornerRadius="12" 
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="buttonScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="1.5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Foreground="#AAA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="30"/>
    </Page.RenderTransform>

    <Border Background="White" CornerRadius="25" Padding="30" Margin="20" BorderBrush="#F0F0F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5,0,0,25">
                <TextBlock Text="USER ACCESS MANAGEMENT" FontSize="26" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                <Button Content="+ ADD NEW USER" HorizontalAlignment="Right" 
                        Style="{StaticResource AnimatedButton}" Background="{StaticResource MintGreen}" 
                        Width="160" Height="42" Click="AddUser_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearchUser" Style="{StaticResource CyberInput}" Tag="Search by Employee ID, Name or Department..."/>
                <Button Grid.Column="1" 
                    Style="{StaticResource AnimatedButton}" 
                    Width="130" 
                    Height="48" 
                    Margin="12,0,0,0" 
                    Click="SearchUser_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border Background="White">
                                <Border.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/64magnifier_FF.png" Stretch="Uniform"/>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <TextBlock Text="SEARCH" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center" 
                   Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid x:Name="dgUsers" Grid.Row="2" AutoGenerateColumns="False" Background="Transparent" 
          BorderThickness="0" RowHeight="60" IsReadOnly="True" GridLinesVisibility="Horizontal" 
          HorizontalGridLinesBrush="#F5F5F5" HeadersVisibility="Column"
          ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
          
          HorizontalScrollBarVisibility="Disabled"
          ColumnWidth="*">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP ID" Binding="{Binding EmpID}" Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="FULL NAME" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" FontWeight="Bold" 
                               TextTrimming="CharacterEllipsis" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Function Higthlight Color -->
                    <DataGridTemplateColumn Header="ROLE LEVEL" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="roleBorder" CornerRadius="10" Padding="10,5" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="12">
                                    <TextBlock x:Name="roleText" Text="{Binding RoleLevel}" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                
                                <DataTemplate.Triggers>

                                    <!-- Function Higthlight Color : Admin -->
                                    <DataTrigger Binding="{Binding RoleLevel}" Value="Admin">
                                        <Setter TargetName="roleBorder" Property="Background" Value="#E8EAF6"/>
                                        <Setter TargetName="roleText" Property="Foreground" Value="#3F51B5"/>
                                    </DataTrigger>
                                    <!-- End Function -->

                                    <!-- Function Higthlight Color : Manager -->
                                    <DataTrigger Binding="{Binding RoleLevel}" Value="Manager">
                                        <Setter TargetName="roleBorder" Property="Background" Value="#E1F5FE"/>
                                        <Setter TargetName="roleText" Property="Foreground" Value="#0288D1"/>
                                    </DataTrigger>
                                    <!-- End Function -->

                                    <!-- Function Higthlight Color : User -->
                                    <DataTrigger Binding="{Binding RoleLevel}" Value="User">
                                        <Setter TargetName="roleBorder" Property="Background" Value="#E8EAF6"/>
                                        <Setter TargetName="roleText" Property="Foreground" Value="#3F51B5"/>
                                    </DataTrigger>
                                    <!-- End Function -->

                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- End Function -->
                    
                    <!-- Function Header : Action -->
                    <DataGridTemplateColumn Header="ACTION" Width="1.8*">

                        <!-- Function Actions : Button -->
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Function Button : VIEW -->
                                    <Button Content="VIEW" Style="{StaticResource AnimatedButton}" 
                                        Background="#0288D1" Width="60" Height="30" Margin="0,0,8,0" 
                                        Click="ViewUser_Click"/>
                                    <!-- End Function -->

                                    <!-- Function Button : EDIT -->
                                    <Button Content="EDIT" Style="{StaticResource AnimatedButton}" 
                                        Background="{StaticResource AccentPurple}" Width="60" Height="30" Margin="0,0,8,0" 
                                        Click="EditUser_Click"/>
                                    <!-- End Function -->

                                    <!-- Function Button : DELETE -->
                                    <Button Content="DELETE" Style="{StaticResource AnimatedButton}" 
                                        Background="{StaticResource DestructiveRed}" Width="60" Height="30" 
                                        Click="DeleteUser_Click"/>
                                    <!-- End Function -->
                                    
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <!-- End Function -->
                        
                    </DataGridTemplateColumn>
                    <!-- End Function -->
                    
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>