<Window x:Class="CIMS.Views.DeductMissWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Not Deducted" Width="1500" Height="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- ⚠ NOT DEDUCTED: ป้ายที่ยังไม่รับเข้า (รอดำเนินการ) + ช่อง ACTION (APPROVE ของ Multi-Scanner)
         ✔ DEDUCTED: เพิ่มอะไรเข้ามา (PD CODE / Coil) แล้วตัดอะไรจากคลังต้นทาง - ค้นหา / ช่วงวันที่ / EXPORT -->
    <Border Background="White" CornerRadius="22" Margin="12" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="hdrBar" Background="#E65100" CornerRadius="21,21,0,0" Padding="24,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Margin="0,0,50,0">
                        <TextBlock x:Name="txtTitle" Text="⚠ NOT DEDUCTED" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock x:Name="txtSub" Text="Labels scanned but NOT in stock yet - waiting for a person with APPROVE of Multi-Scanner"
                                   Foreground="#FFE0B2" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Close_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,14,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Style="{StaticResource StkInput}" Height="42" Tag="Search coil no, mother coil, PD code, product, user..." TextChanged="Search_Changed"/>
                <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FROM" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpFrom" Width="140" SelectedDateChanged="Date_Changed"/>
                    <TextBlock Text="TO" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <DatePicker x:Name="dpTo" Width="140" SelectedDateChanged="Date_Changed"/>
                    <Button x:Name="btnExport" Content="📤 EXPORT" Style="{StaticResource StkButton}" Background="#1976D2" Margin="12,0,0,0" Click="Export_Click" ToolTip="Export the ticked rows (none ticked = every row shown)"/>
                </WrapPanel>
            </Grid>

            <!-- จอเล็ก: คอลัมน์ไม่ถูกบีบจนอ่านไม่ได้ (เลื่อนซ้าย-ขวาได้) / ข้อมูลเยอะ: Virtualizing ไม่ค้าง -->
            <DataGrid x:Name="dgMiss" Grid.Row="2" Margin="20,0,20,0"
                      AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="Transparent" BorderThickness="0" MinRowHeight="50" FontSize="13" FontWeight="SemiBold"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F2F0F5" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="4,4"/>
                        <Setter Property="Height" Value="52"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <DataTemplate x:Key="WrapHead">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                    <Style x:Key="Cell" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                    <Style x:Key="Cut" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                        <Setter Property="Foreground" Value="#2E7D32"/>
                        <Setter Property="FontWeight" Value="Black"/>
                    </Style>
                    <Style x:Key="Pending" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                        <Setter Property="Foreground" Value="#E65100"/>
                        <Setter Property="FontWeight" Value="Black"/>
                    </Style>
                    <Style x:Key="ActBtn" TargetType="Button" BasedOn="{StaticResource StkCardButton}">
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" MinWidth="44">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="chkAll" HorizontalAlignment="Center" Click="SelectAll_Click" ToolTip="Select all"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Row_Checked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn HeaderTemplate="{StaticResource WrapHead}" Header="SCAN DATE" Binding="{Binding DateText}" Width="1.05*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn HeaderTemplate="{StaticResource WrapHead}" Header="PD CODE" Binding="{Binding PartCodeText}" Width="1.05*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn HeaderTemplate="{StaticResource WrapHead}" Header="PRODUCT NAME" Binding="{Binding PartNameText}" Width="1.6*" MinWidth="150" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn HeaderTemplate="{StaticResource WrapHead}" Header="MOTHER COIL" Binding="{Binding MotherCoil}" Width="0.95*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn HeaderTemplate="{StaticResource WrapHead}" Header="COIL NO" Binding="{Binding CoilNo}" Width="1.05*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>

                    <!-- ✔ DEDUCTED -->
                    <DataGridTextColumn x:Name="colCut" HeaderTemplate="{StaticResource WrapHead}" Header="CUT FROM SOURCE" Binding="{Binding DeductedText}" Width="0.8*" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource Cut}" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="colSrcPart" HeaderTemplate="{StaticResource WrapHead}" Header="SOURCE PD CODE" Binding="{Binding SourcePartCode}" Width="1.05*" MinWidth="105" IsReadOnly="True" ElementStyle="{StaticResource Cell}" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="colSrcName" HeaderTemplate="{StaticResource WrapHead}" Header="SOURCE PRODUCT NAME" Binding="{Binding SourcePartName}" Width="1.5*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource Cell}" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="colMotherBefore" HeaderTemplate="{StaticResource WrapHead}" Header="MOTHER COIL BEFORE" Binding="{Binding MotherBeforeText}" Width="0.9*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource Cell}" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="colSrcAfter" HeaderTemplate="{StaticResource WrapHead}" Header="SOURCE BALANCE" Binding="{Binding SourceAfterText}" Width="0.8*" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource Cell}" Visibility="Collapsed"/>

                    <!-- ⚠ NOT DEDUCTED -->
                    <DataGridTextColumn x:Name="colScanned" HeaderTemplate="{StaticResource WrapHead}" Header="SCANNED QTY (NOT IN STOCK)" Binding="{Binding LabelQtyText}" Width="0.85*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource Pending}"/>
                    <DataGridTemplateColumn x:Name="colStatus" Header="STATUS" Width="1.9*" MinWidth="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                    <TextBlock Text="{Binding StatusText}" FontWeight="Black" Foreground="#E65100" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding ReasonText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding MotherNowText}" FontSize="11" Foreground="#8A8490" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn HeaderTemplate="{StaticResource WrapHead}" Header="USER" Binding="{Binding UserId}" Width="0.6*" MinWidth="60" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>

                    <!-- ACTION: เฉพาะผู้มีสิทธิ์ APPROVE ของ Multi-Scanner -->
                    <DataGridTemplateColumn x:Name="colAction" Header="ACTION" Width="1.55*" MinWidth="170" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="✔ APPROVE" Style="{StaticResource ActBtn}" Foreground="#2E7D32" Background="#E8F5E9" Click="Approve_Click" Tag="{Binding}"
                                            IsEnabled="{Binding HasProduct}" ToolTip="Receive into stock now (+ cut the source when the mother coil is there)" ToolTipService.ShowOnDisabled="True"/>
                                    <Button Content="＋ PRODUCT" Style="{StaticResource ActBtn}" Foreground="#1565C0" Background="#E3F2FD" Click="Register_Click" Tag="{Binding}"
                                            ToolTip="Register the product (Product Control) then receive"/>
                                    <Button Content="🗑 DEL" Style="{StaticResource ActBtn}" Foreground="#C62828" Background="#FDECEC" Click="DeleteRow_Click" Tag="{Binding}"
                                            ToolTip="Delete this label (nothing is saved to stock)"/>
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="txtEmpty" Grid.Row="2" Text="NOTHING WAITING IN THIS RANGE" FontSize="15" FontWeight="Bold" Foreground="#AAA"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <Grid Grid.Row="3" Margin="20,10,20,16">
                <TextBlock x:Name="txtStatus" FontSize="12" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Border>
</Window>
