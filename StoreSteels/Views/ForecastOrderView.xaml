<Page x:Class="CIMS.Views.ForecastOrderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="ForecastOrderView" Background="Transparent">

    <!-- 📊 Forecast / Order / Delivery: กราฟแท่งทั้งปี (ซ้าย) + TOP 5 Order (ขวา) + Import / ตารางตามลูกค้า / Export -->
    <Page.Resources>
        <Style x:Key="CustomerHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <Border Background="#F3E5F5" CornerRadius="5" Height="38" Margin="0,0,0,5" BorderBrush="{StaticResource MainPurple}" BorderThickness="2,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="👥 CUSTOMER : " FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="15" Margin="5,0,0,0"/>
                                    <Border Background="{StaticResource MainPurple}" CornerRadius="12" Padding="12,6" Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} ITEMS'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ItemsPresenter Margin="0,0,0,5"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Border Background="White" CornerRadius="25" Margin="35,35,35,35" Padding="30,25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.05" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="330"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- หัวหน้า -->
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="📊 FORECAST · ORDER · DELIVERY" FontSize="26" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                    <TextBlock x:Name="txtSub" Text="Monthly forecast, customer orders and deliveries" FontSize="13" FontWeight="SemiBold" Foreground="#8A8490" Margin="2,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="MONTH :" FontWeight="Bold" Foreground="#373737" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbMonth" Width="170" Height="42" Style="{StaticResource StkCombo}" SelectionChanged="cbMonth_SelectionChanged"/>
                    <Button x:Name="btnImport" Content="📥 IMPORT FORECAST / ORDER / DELIVERY" Style="{StaticResource StkButton}" Background="#2E7D32" Margin="10,0,0,0" Click="Import_Click"/>
                    <Button x:Name="btnExport" Content="📤 EXPORT" Style="{StaticResource StkButton}" Background="#1976D2" Margin="10,0,0,0" Click="Export_Click"/>
                </StackPanel>
            </Grid>

            <!-- กราฟ (ซ้าย) + TOP 5 (ขวา) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="16" Margin="0,0,10,0" Padding="20,14" BorderBrush="#EFF2F6" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#A0AEC0" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtChartTitle" Text="Forecast, Order &amp; Delivery" FontSize="17" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,6"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding BarSeries}" LegendLocation="Top" DisableAnimations="True">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding ChartLabels}" Foreground="#718096">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" IsEnabled="False"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding ValuesFormatter}" Foreground="#718096" MinValue="0" MaxValue="{Binding AxisMax, TargetNullValue=NaN}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="16" Margin="10,0,0,0" Padding="20,14" BorderBrush="#EFF2F6" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#A0AEC0" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtTopTitle" Text="TOP 5 ORDER" FontSize="17" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtTopEmpty" Grid.Row="1" Text="NO ORDER IN THIS MONTH" Foreground="#AAA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ItemsControl x:Name="icTop" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource MainPurple}" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Rank}" Foreground="White" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="Black" FontSize="13" Foreground="#2D2A32" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                                <TextBlock HorizontalAlignment="Right" FontWeight="Black" FontSize="13" Foreground="#6A1B9A">
                                                    <Run Text="{Binding OrderText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ShareText, Mode=OneWay}" Foreground="#8A8490" FontSize="11"/>
                                                </TextBlock>
                                            </Grid>
                                            <Grid Height="9" Margin="0,3,0,1">
                                                <Border Background="#EEE9F5" CornerRadius="5"/>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="10" BorderThickness="0" Background="Transparent" Foreground="#6A1B9A">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid x:Name="PART_Track">
                                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5" Background="{TemplateBinding Foreground}"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                            </Grid>
                                            <TextBlock Text="{Binding Sub}" FontSize="11" FontWeight="SemiBold" Foreground="#8A8490" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ค้นหา -->
            <Grid Grid.Row="2" Margin="0,18,0,10">
                <TextBox x:Name="txtSearch" Height="44" Style="{StaticResource StkInput}" Tag="Search Customer, Part A, Part No or Product Name..." TextChanged="txtSearch_TextChanged"/>
            </Grid>

            <!-- ตาราง (จัดกลุ่มตามลูกค้า เหมือน Store Max-Min / StorePC) -->
            <DataGrid x:Name="dgRows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      Background="Transparent" BorderThickness="0" RowHeight="46" FontSize="13" FontWeight="SemiBold"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F5F5F5" CanUserAddRows="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.ScrollChanged="dgRows_ScrollChanged" SizeChanged="dgRows_SizeChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="Height" Value="52"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource CustomerHeaderStyle}"/>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="70" MinWidth="70" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="PART A" Binding="{Binding PartA}" Width="1*" MinWidth="130" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="PART NO" Binding="{Binding PartNo}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Width="2*" MinWidth="240" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn MinWidth="110" Header="FORECAST" Binding="{Binding Forecast, StringFormat={}{0:#,##0.##}}" Width="0.9*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn MinWidth="110" Header="ORDER" Binding="{Binding Order, StringFormat={}{0:#,##0.##}}" Width="0.9*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn MinWidth="110" Header="DELIVERY" Binding="{Binding Delivery, StringFormat={}{0:#,##0.##}}" Width="0.9*" ElementStyle="{StaticResource Cell}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="txtEmpty" Grid.Row="3" Text="NO DATA - IMPORT FORECAST / ORDER / DELIVERY FIRST" FontSize="15" FontWeight="Bold" Foreground="#AAA"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Page>
