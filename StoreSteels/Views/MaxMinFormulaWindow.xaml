<Window x:Class="CIMS.Views.MaxMinFormulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Max-Min Formulas" Width="1000" Height="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- รายการสูตรคำนวณ MAX / MIN (เพิ่ม / แก้ไข / ลบ เหมือน Barcode Formats) แต่ละคลังเลือกใช้สูตรที่หน้า Max-Min Calculator -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="⚙ MAX-MIN FORMULAS" Foreground="White" FontSize="20" FontWeight="Black"/>
                    <TextBlock Text="MAX = Round(Qty / Workdays / PackSize per day) x MAX DAYS  •  each stock chooses its formula on the Max-Min Calculator page"
                               Foreground="#D0BCFF" FontSize="12" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- รายชื่อสูตร -->
                <Border Grid.Column="0" Style="{StaticResource StkSection}" Margin="0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="＋ NEW FORMULA" Style="{StaticResource StkButton}" Margin="0,10,0,0" Click="New_Click"/>
                        <TextBlock DockPanel.Dock="Top" Text="FORMULAS" Style="{StaticResource StkLabel}"/>
                        <ListBox x:Name="lstFormulas" BorderThickness="0" Background="Transparent" SelectionChanged="lstFormulas_SelectionChanged" DisplayMemberPath="DisplayName">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="10" Padding="12,9" Margin="0,0,0,6" Background="White" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#6750A4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="#49454F"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ตัวแก้ไขสูตร -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource StkSection}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FORMULA NAME" Style="{StaticResource StkLabel}"/>
                                    <TextBox x:Name="txtName" Style="{StaticResource StkInput}" MaxLength="50" Tag="e.g. ORDER ROUND UP"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="QUANTITY FROM" Style="{StaticResource StkLabel}"/>
                                    <ComboBox x:Name="cbSource" Style="{StaticResource StkCombo}" SelectionChanged="Input_Changed">
                                        <ComboBoxItem Content="ORDER"/>
                                        <ComboBoxItem Content="FORECAST"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="ROUNDING (PER DAY)" Style="{StaticResource StkLabel}"/>
                                    <ComboBox x:Name="cbRound" Style="{StaticResource StkCombo}" SelectionChanged="Input_Changed">
                                        <ComboBoxItem Content="ROUND UP"/>
                                        <ComboBoxItem Content="ROUND NEAREST"/>
                                        <ComboBoxItem Content="ROUND DOWN"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource StkSection}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DEFAULT MAX (DAYS)" Style="{StaticResource StkLabel}"/>
                                        <TextBox x:Name="txtDefMax" Style="{StaticResource StkInput}" MaxLength="3" TextChanged="Input_Changed" PreviewTextInput="Digits_PreviewTextInput"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DEFAULT MIN (DAYS)" Style="{StaticResource StkLabel}"/>
                                        <TextBox x:Name="txtDefMin" Style="{StaticResource StkInput}" MaxLength="3" TextChanged="Input_Changed" PreviewTextInput="Digits_PreviewTextInput"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="DEFAULT WORKDAYS" Style="{StaticResource StkLabel}"/>
                                        <TextBox x:Name="txtDefWd" Style="{StaticResource StkInput}" MaxLength="2" TextChanged="Input_Changed" PreviewTextInput="Digits_PreviewTextInput"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Defaults are used for parts without their own MAX / MIN (DAYS), and for a month without a customer calendar and without WORK DAYS in the import."
                                           FontSize="11" Foreground="#8A8490" FontWeight="SemiBold" Margin="2,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ตัวอย่างสด (ไม่ได้บันทึก / ไม่ได้ใช้คำนวณจริง) -->
                        <Border CornerRadius="16" Background="#F7F4FC" BorderBrush="#E4DDF0" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="EXAMPLE  (PREVIEW ONLY - the real calculation uses each part's Order, Workdays and PackSize)" Style="{StaticResource StkLabel}" TextWrapping="Wrap"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="lblExQty" Text="ORDER" FontSize="11" FontWeight="Bold" Foreground="#8A8490"/>
                                        <TextBox x:Name="txtExQty" Text="20000" Style="{StaticResource StkInput}" TextChanged="Input_Changed" PreviewTextInput="Digits_PreviewTextInput"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WORKDAYS" FontSize="11" FontWeight="Bold" Foreground="#8A8490"/>
                                        <TextBox x:Name="txtExWd" Text="21" Style="{StaticResource StkInput}" TextChanged="Input_Changed" PreviewTextInput="Digits_PreviewTextInput"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PACKSIZE" FontSize="11" FontWeight="Bold" Foreground="#8A8490"/>
                                        <TextBox x:Name="txtExPack" Text="50" Style="{StaticResource StkInput}" TextChanged="Input_Changed" PreviewTextInput="Digits_PreviewTextInput"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="txtExSteps" FontSize="13" FontWeight="Bold" Foreground="#49454F" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border CornerRadius="12" Background="White" Padding="16,8" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock x:Name="lblExMax" Text="MAX" FontSize="11" FontWeight="Bold" Foreground="#8A8490"/>
                                            <TextBlock x:Name="txtExMax" FontSize="26" FontWeight="Black" Foreground="#2E7D32"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="12" Background="White" Padding="16,8">
                                        <StackPanel>
                                            <TextBlock x:Name="lblExMin" Text="MIN" FontSize="11" FontWeight="Bold" Foreground="#8A8490"/>
                                            <TextBlock x:Name="txtExMin" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentPurple}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="txtFormula" FontSize="11" FontWeight="SemiBold" Foreground="#6B6770" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="22,10,22,22">
                <Button x:Name="btnDelete" Content="🗑 DELETE" Style="{StaticResource StkButton}" Background="#C62828" HorizontalAlignment="Left" Click="Delete_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CLOSE" Style="{StaticResource StkButton}" Background="#9E9E9E" Margin="0,0,10,0" Click="Close_Click"/>
                    <Button x:Name="btnSave" Content="SAVE FORMULA" Style="{StaticResource StkButton}" Background="{StaticResource AccentPurple}" MinWidth="150" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
