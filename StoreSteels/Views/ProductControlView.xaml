<Page x:Class="CIMS.Views.ProductControlView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:CIMS.ViewModels"
      xmlns:conv="clr-namespace:CIMS.Converters"
      Title="QR Code Generator" Background="Transparent"
      RenderTransformOrigin="0.5,0.5">

    <Page.DataContext>
        <vm:ProductControlViewModel />
    </Page.DataContext>

    <Page.Resources>
        <!-- MintGreen is page-specific: ManageUserView.xaml uses the same key name for a
             different color (#4CAF50), so it is intentionally not centralized. -->
        <SolidColorBrush x:Key="MintGreen" Color="#2DFFB4"/>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CyberPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="buttonScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource SoftGray}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#EEE" BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CyberPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="UltraBold"/>
            <Setter Property="Foreground" Value="{StaticResource CyberPurple}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- หัวกลุ่มของตาราง แบบเดียวกับหน้า Store (Max-Min) -->
        <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,0,0,5">
                            <Expander.Template>
                                <ControlTemplate TargetType="{x:Type Expander}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" HorizontalAlignment="Stretch"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                                    </DockPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Expander.Template>
                            <Expander.Header>
                                <Border CornerRadius="5" Height="38" BorderBrush="{StaticResource MainPurple}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3E5F5"/>
                                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EADCF3"/>
                                                    <Setter Property="BorderThickness" Value="5,0,0,0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Text="{Binding DataContext.GroupLabel, RelativeSource={RelativeSource AncestorType=DataGrid}, StringFormat='{}{0} : '}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="14"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="15" Margin="5,0,0,0"/>
                                        <Border Background="{StaticResource MainPurple}" CornerRadius="12" Padding="12,6" Margin="15,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} ITEMS'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <ItemsPresenter Margin="0,5,0,5"/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterCellStyle" TargetType="DataGridCell">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource CyberPink}"/>
                    <Setter Property="Foreground" Value="{StaticResource DeepDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Page.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="30"/>
    </Page.RenderTransform>

    <Border x:Name="MainBorder" Background="White" CornerRadius="25" Padding="30" Margin="20" BorderBrush="#F0F0F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,20">
                <!-- ไอคอนกล่องสี (Assets/Icons/InventoryRegistrationPage.png) หน้าชื่อหน้า -->
                <Image Source="/Assets/Icons/InventoryRegistrationPage.png" Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Inventory Registration" FontSize="30" FontWeight="Black" Foreground="{StaticResource MainPurple}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
                    <Border Width="150" Height="150" Background="{StaticResource SoftGray}" 
                            CornerRadius="15" BorderBrush="#EEE" BorderThickness="1.5">
                        <Image Source="{Binding SelectedProduct.FullImagePath, UpdateSourceTrigger=PropertyChanged}" 
                               Stretch="Uniform" Margin="5"/>
                    </Border>
                    <Button Content="Select IMAGE" 
                            Click="btnSelectImage_Click" Visibility="{Binding ImageVisibility}" 
                            Style="{StaticResource CyberButton}" 
                            Background="{StaticResource MainPurple}" 
                            Width="160" Height="40" Margin="0,12,0,0" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <!-- ลำดับช่องกรอก: SUPPLIER, CUSTOMER, CATEGORY, PART A, PART B, MODEL, PRODUCT CODE, PART NO, PRODUCT NAME, PACKSIZE, BIN, MOTHER COIL, COIL NO, QR CODE
                         SUPPLIER / CUSTOMER / CATEGORY: พิมพ์แล้วขึ้นค่าที่มีในระบบให้เลือก (SuggestBox) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="SUPPLIER" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSupplier" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.CustomerCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCustomer" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" MaxLength="100" Text="{Binding SelectedProduct.Customer, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                            <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCategory" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.Category, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                            <TextBlock Text="PART A" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPartA" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" MaxLength="100" Text="{Binding SelectedProduct.PartA, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="5">
                            <TextBlock Text="PART B" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPartB" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" MaxLength="100" Text="{Binding SelectedProduct.PartB, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtModel" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" MaxLength="100" Text="{Binding SelectedProduct.Model, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="PRODUCT CODE" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtProductCode" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.PartCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                            <TextBlock Text="PART NO" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPartNo" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" MaxLength="100" Text="{Binding SelectedProduct.PartNo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="5">
                            <TextBlock Text="PRODUCT NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtProductName" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.PartName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="5">
                            <TextBlock Text="PACKSIZE" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPcs" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.PackSize, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="txtPcs_PreviewTextInput" DataObject.Pasting="txtPcs_Pasting" InputMethod.IsInputMethodEnabled="False" MaxLength="9"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                            <TextBlock Text="BIN" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtBin" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.Location, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- 🧲 Coil ในคลังของสินค้า (ทะเบียน Coil) - แสดงอย่างเดียว: Coil รับเข้าด้วยการสแกน / IMPORT EXCEL -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                            <TextBlock Text="MOTHER COIL" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtMotherCoil" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" IsReadOnly="True" Background="#ECEAF1"
                                     ToolTip="Mother coils of this product in stock (read only - coils come in by scanning or IMPORT EXCEL)"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="5">
                            <TextBlock Text="COIL NO" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCoilNo" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" IsReadOnly="True" Background="#ECEAF1"
                                     ToolTip="Coil numbers of this product in stock (read only - coils come in by scanning or IMPORT EXCEL)"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="5">
                            <TextBlock Text="QR CODE" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtQRCode" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Text="{Binding SelectedProduct.QRCodeData, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- 🏬 สินค้านี้อยู่คลังไหนบ้าง (คลังหลัก = แสดงในตารางคลังหลัก / คลังอื่น = เพิ่มเข้าคลังนั้น ยอดเริ่ม 0) -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="5">
                            <TextBlock Text="STOCK" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel x:Name="wpStocks"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="5,13,0,0">
                        <!--<Button x:Name="btnGenerate" Content="GENERATE QR" Style="{StaticResource CyberButton}" Width="150" Height="42" Click="GenerateQR_Click"
                                FontSize="12" FontWeight="ExtraBlack" />-->
                        <Button x:Name="btnRegister" Content="PART REGISTRATION" Style="{StaticResource CyberButton}" Width="180" Height="42" Background="{StaticResource MintGreen}" 
                        Foreground="{StaticResource DeepDark}" Click="RegisterPart_Click" Visibility="Visible" FontSize="12" FontWeight="ExtraBlack" />

                        <Button x:Name="btnSave" Content="SAVE CHANGES" Style="{StaticResource CyberButton}" Width="180" Height="42" Background="{StaticResource CyberPink}" 
                        Foreground="{StaticResource DeepDark}" Click="SaveEdit_Click" Visibility="Collapsed" FontSize="12" FontWeight="ExtraBlack" />
                        <Grid Margin="10,0,0,0">
                            
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="5,0,5,15">
                <!-- ช่องค้นหายืดเต็มพื้นที่ที่เหลือ (เดิมล็อกกว้าง 1200 จนดันปุ่ม FIND ไปซ่อนใต้ปุ่มด้านขวา) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" FontSize="13" FontWeight="Bold" Style="{StaticResource ModernInput}" Tag="Search by name or code..." TextChanged="txtSearch_TextChanged" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                <Button Grid.Column="1" Style="{StaticResource CyberButton}" Width="80" Height="42" Margin="10,0,20,0" Click="Find_Click" FontSize="12" FontWeight="ExtraBold" >
                    <TextBlock Text="FIND" VerticalAlignment="Center"/>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 🏬 กรองตารางตามคลัง -->
                    <ComboBox x:Name="cbStockFilter" Width="190" Height="45" Margin="0,0,10,0" Style="{StaticResource StkCombo}"
                              SelectionChanged="cbStockFilter_SelectionChanged" ToolTip="Show only the products in this stock" Visibility="Collapsed"/>
                    <Button x:Name="btnTemplate" Content="📄 TEMPLATE" Style="{StaticResource CyberButton}" Background="#6750A4" Width="140" Height="45" Margin="0,0,10,0" Click="Template_Click" Visibility="{Binding AddVisibility}" FontSize="12" FontWeight="ExtraBold"
                            ToolTip="Excel file to fill in for IMPORT EXCEL (many products at once)"/>
                    <Button Content="📥 IMPORT EXCEL" Style="{StaticResource CyberButton}" Background="{StaticResource MainPurple}" Width="170" Height="45" Margin="0,0,10,0" Click="Import_Click" Visibility="{Binding AddVisibility}" FontSize="12" FontWeight="ExtraBold" />
                    <Button Content="EXPORT QR SELECT" Style="{StaticResource CyberButton}" Width="200" Height="45" Click="Export_Click" FontSize="12" FontWeight="ExtraBold" />
                    <!-- 🛠 ADMIN (Level 1 เท่านั้น): STOCK DELETE / ตารางของแต่ละคลัง / รูปแบบ QR Code -->
                    <Button x:Name="btnAdmin" Content="🛠 ADMIN" Style="{StaticResource CyberButton}" Background="#2D2A32" Width="130" Height="45" Margin="10,0,0,0"
                            Click="Admin_Click" Visibility="Collapsed" FontSize="12" FontWeight="ExtraBold" ToolTip="Admin tools: STOCK DELETE, table columns of each stock, QR code format"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" CornerRadius="20" Background="#FDFDFD" BorderBrush="#F0F0F0" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="dgQRHistory" 
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.ScrollChanged="dgQRHistory_ScrollChanged"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          RowDetailsVisibilityMode="Collapsed"
                          LoadingRow="dgQRHistory_LoadingRow"
                          PreviewMouseLeftButtonUp="dgQRHistory_PreviewMouseLeftButtonUp"
                          ItemsSource="{Binding Products}"
                          HeadersVisibility="Column" IsReadOnly="True" 
                          AutoGenerateColumns="False" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          RowHeight="90"
                          FontSize="13"
                          FontWeight="Bold"
                          CellStyle="{StaticResource CenterCellStyle}"
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F5F5F5">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="15,0"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="ExtraBold"/>
                            <Setter Property="Height" Value="50"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- ✨ เมาส์ชี้แถว = พื้นม่วงอ่อน -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FAF6FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- 🧲 แถว Coil แม่ / Coil ลูก ใต้สินค้า (สร้างในโค้ด BuildCoilRows) -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Loaded="CoilDetails_Loaded" Background="White"/>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>

                    <!-- หัวกลุ่ม (CATEGORY / CUSTOMER / SUPPLIER ตามที่ตั้งต่อคลัง) แบบเดียวกับหน้า Store (Max-Min) - คลิกเพื่อพับ / ขยาย -->
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"/>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="colSelect" Width="60">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkSelectAll" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Click="SelectAll_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="colImage" Header="IMAGE" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="White" Width="75" Height="75" CornerRadius="6" BorderBrush="#F0F0F0" BorderThickness="1" Margin="5">
                                        <Image Source="{Binding ProductImage, UpdateSourceTrigger=PropertyChanged}" Stretch="Uniform" MaxHeight="75"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- คอลัมน์ทั้งหมดที่เลือกแสดงได้ - คลังไหนแสดงคอลัมน์ไหน / ลำดับไหน ตั้งที่ปุ่ม ADMIN (CIMS.ProductControlSettings) -->
                        <DataGridTextColumn x:Name="colSupplier" Header="SUPPLIER" Binding="{Binding CustomerCode}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colCustomer" Header="CUSTOMER" Binding="{Binding Customer}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colCategory" Header="CATEGORY" Binding="{Binding Category}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colPartA" Header="PART A" Binding="{Binding PartA}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colPartB" Header="PART B" Binding="{Binding PartB}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colModel" Header="MODEL" Binding="{Binding Model}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <!-- คลังที่นับ Coil: มีป้าย ▸ n = กด PRODUCT CODE เปิด / ปิดแถว Coil แม่ / Coil ลูก -->
                        <DataGridTemplateColumn x:Name="colCode" Header="PRODUCT CODE" Width="1.2*" SortMemberPath="PartCode">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="codeBox" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" Background="Transparent">
                                        <TextBlock x:Name="codeText" Text="{Binding PartCode}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="coilBadge" Visibility="{Binding CoilBadgeVisibility}" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                CornerRadius="9" Padding="8,2" Background="#EDE7F6" ToolTip="Click to show / hide the coils of this product">
                                            <TextBlock x:Name="badgeText" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource MainPurple}">
                                                <Run Text="{Binding CoilArrow, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding CoilCount, Mode=OneWay}"/><Run Text=" COIL"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CoilBadgeVisibility}" Value="Visible">
                                            <Setter TargetName="codeBox" Property="Cursor" Value="Hand"/>
                                            <Setter TargetName="codeText" Property="Foreground" Value="{StaticResource MainPurple}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCoilOpen}" Value="True">
                                            <Setter TargetName="coilBadge" Property="Background" Value="{StaticResource MainPurple}"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CoilBadgeVisibility}" Value="Visible"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=codeBox}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="codeText" Property="TextDecorations" Value="Underline"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="colPartNo" Header="PART NO" Binding="{Binding PartNo}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colName" Header="PRODUCT NAME" Binding="{Binding PartName}" Width="2*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colPackSize" Header="PACKSIZE" Binding="{Binding PackSize}" Width="0.8*"/>
                        <DataGridTextColumn x:Name="colBin" Header="BIN" Binding="{Binding Location}" Width="1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colMother" Header="MOTHER COIL" Binding="{Binding MotherCoil}" Width="1.1*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colCoilNo" Header="COIL NO" Binding="{Binding CoilNo}" Width="1.2*" ElementStyle="{StaticResource WrapCell}"/>
                        <DataGridTextColumn x:Name="colQr" Header="QR CODE" Binding="{Binding QRCodeData}" Width="1.2*" ElementStyle="{StaticResource WrapCell}"/>

                        <DataGridTemplateColumn x:Name="colAction" Header="ACTION" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="VIEW" 
                                                Click="ViewAction_Click" 
                                                Style="{StaticResource CyberButton}" 
                                                Background="{StaticResource CyberPink}" 
                                                Foreground="{StaticResource DeepDark}" FontWeight="Black"
                                                Height="28" Width="55" Margin="0,0,5,0" FontSize="11"/>

                                        <Button Style="{StaticResource CyberButton}" 
                                                Width="55" Height="28" Margin="0,0,5,0" FontSize="11"
                                                Click="ToggleVisibility_Click" FontWeight="Black" Visibility="{Binding DataContext.EditVisibility, RelativeSource={RelativeSource AncestorType=Page}}"
                                                Content="{Binding IsShow, Converter={StaticResource BoolToShowHide}}"
                                                Background="{Binding IsShow, Converter={StaticResource BoolToShowColor}}">
                                        </Button>

                                        <Button Content="EDIT" 
                                                Style="{StaticResource CyberButton}" 
                                                Background="{StaticResource CyberPurple}" FontWeight="Black"
                                                Width="55" Height="28" Margin="0,0,5,0" FontSize="11"
                                                Click="EditPD_Click" Visibility="{Binding DataContext.EditVisibility, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                        <Button Content="DEL" 
                                                Style="{StaticResource CyberButton}" 
                                                Background="#FF5252" FontWeight="Black"
                                                Width="55" Height="28" FontSize="11"
                                                Click="DeletePD_Click" Visibility="{Binding DataContext.DeleteVisibility, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Page>