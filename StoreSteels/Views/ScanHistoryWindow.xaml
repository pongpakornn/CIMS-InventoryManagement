<Window x:Class="CIMS.Views.ScanHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan History" Width="1320" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 🕘 ประวัติการสแกน: ค้นหา (ไม่ค้าง) / ช่วงวันที่ / คลัง / ประเภท / Export - แสดง 20 แถวแรก เลื่อนเพิ่มทีละ 15 จนครบ 50 แล้วกดหน้าถัดไป -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🕘 SCAN HISTORY" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="Search, filter by date / stock / type and export the scan records" Foreground="#D0BCFF" FontSize="12" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Close_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <!-- ตัวกรอง -->
            <Grid Grid.Row="1" Margin="24,16,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Style="{StaticResource StkInput}" Height="42" Tag="Search Product Code, Part A, Part No, Name, Barcode or User..." TextChanged="Filter_Changed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="FROM" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpFrom" Width="150" SelectedDateChanged="Date_Changed"/>
                    <TextBlock Text="TO" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <DatePicker x:Name="dpTo" Width="150" SelectedDateChanged="Date_Changed"/>
                    <ComboBox x:Name="cbStock" Width="190" Height="42" Margin="12,0,0,0" Style="{StaticResource StkCombo}" SelectionChanged="Combo_Changed"/>
                    <ComboBox x:Name="cbType" Width="120" Height="42" Margin="8,0,0,0" Style="{StaticResource StkCombo}" SelectionChanged="Combo_Changed">
                        <ComboBoxItem Content="ALL TYPES" Tag=""/>
                        <ComboBoxItem Content="IN" Tag="IN"/>
                        <ComboBoxItem Content="OUT" Tag="OUT"/>
                        <ComboBoxItem Content="RETURN" Tag="RETURN"/>
                    </ComboBox>
                    <Button x:Name="btnExport" Content="📤 EXPORT" Style="{StaticResource StkButton}" Margin="10,0,0,0" Click="Export_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgHistory" Grid.Row="2" Margin="24,0,24,0"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0" MinRowHeight="44" FontSize="13" FontWeight="SemiBold"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F2F0F5" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      ScrollViewer.ScrollChanged="dgHistory_ScrollChanged" PreviewMouseWheel="dgHistory_PreviewMouseWheel" PreviewKeyDown="dgHistory_PreviewKeyDown">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <Style x:Key="Cell" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <!-- บาร์โค้ดเต็มทุกตัว: ตัวหนา ขึ้นบรรทัดใหม่เมื่อยาว (แถวสูงตามข้อความ) -->
                    <Style x:Key="BarcodeCell" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="8,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE TIME" Binding="{Binding DateText}" Width="1.3*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockCode}" Width="1*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="TYPE" Binding="{Binding TxType}" Width="0.7*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding PartName}" Width="1.6*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat='{}{0:#,0.###}'}" Width="0.6*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="USER" Binding="{Binding UserText}" Width="1.1*" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="BARCODE" Binding="{Binding RefNo}" Width="3.6*" ElementStyle="{StaticResource BarcodeCell}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="txtEmpty" Grid.Row="2" Text="NO SCAN RECORD" FontSize="15" FontWeight="Bold" Foreground="#AAA"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- หน้า -->
            <Grid Grid.Row="3" Margin="24,10,24,18">
                <TextBlock x:Name="txtStatus" FontSize="12" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnPrev" Content="◀ PREV" Style="{StaticResource StkButton}" Click="Prev_Click"/>
                    <TextBlock x:Name="txtPage" FontSize="13" FontWeight="Black" Foreground="{StaticResource MainPurple}" VerticalAlignment="Center" Margin="14,0"/>
                    <Button x:Name="btnNext" Content="NEXT ▶" Style="{StaticResource StkButton}" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
