<Window x:Class="CIMS.Views.PRSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CIMS.Helpers"
        Title="PR Settings" Width="1000" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 🧾 PR SETTINGS (User Management - Admin Level 1 เท่านั้น)
         ต่อคลัง: KEEP PR = แสกนออกแล้วสร้าง PR + คลังนี้อยู่ใน Dropdown หน้า PR / EXPORT PATH = ไฟล์ Excel ที่ EXPORT PATH EXCEL ต่อข้อมูลลงไป -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#6750A4" CornerRadius="21,21,0,0" Padding="26,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🧾 PR SETTINGS" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="KEEP PR = scanning OUT creates a PR and the stock shows in the PR page dropdown  •  Excel file of EXPORT PATH = 📊 SETUP EXCEL PATH"
                                   Foreground="#E8DEF8" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Cancel_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="26,16,26,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" BorderThickness="1.5" Padding="16,10" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#E2DEEA"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KeepPr}" Value="True">
                                                <Setter Property="BorderBrush" Value="#6750A4"/>
                                                <Setter Property="Background" Value="#F7F3FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontWeight="Black" FontSize="14" Foreground="#2D2A32"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#8A8490" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="KEEP PR" IsChecked="{Binding KeepPr, Mode=TwoWay}" Style="{StaticResource StkChip}" VerticalAlignment="Center"
                                              Click="Changed_Click"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PathText}" Foreground="#8A8490" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="26,12,26,20">
                <TextBlock x:Name="txtStatus" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#8A8490"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Style="{StaticResource StkButton}" Background="#9E9E9E" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnSave" Content="💾 SAVE" Style="{StaticResource StkButton}" Background="#6750A4" Click="Save_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
