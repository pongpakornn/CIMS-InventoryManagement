<Window x:Class="CIMS.Views.StockPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Stock" Width="900" SizeToContent="Height" MaxHeight="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- หน้าต่างการ์ดคลัง ใช้ 3 แบบ:
         SCAN STOCKS : เลือกคลังที่สแกนร่วมกัน (ติ๊กได้หลายคลัง) + AUTO (ALL STOCKS) + ★ คลังที่ตัดก่อนตอนสแกนออก
         CHOOSE      : สินค้าอยู่หลายคลัง -> กดการ์ดเลือกคลังที่จะลง (1 คลัง)
         PR SETTINGS : ติ๊กคลังที่แสกนออกแล้วสร้าง PR อัตโนมัติ -->

    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="txtTitle" Text="SELECT STOCK" Foreground="White" FontSize="20" FontWeight="Black"/>
                    <TextBlock x:Name="txtSubtitle" Foreground="#D0BCFF" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,10,4">
                <StackPanel>
                    <!-- ⚡ AUTO (ALL STOCKS) - เฉพาะหน้าเลือกคลังสแกน -->
                    <Border x:Name="cardAuto" CornerRadius="18" Margin="0,0,14,16" Padding="20,14" Cursor="Hand" BorderThickness="2"
                            Background="#F7F4FC" BorderBrush="#ECE9F1" MouseLeftButtonUp="CardAuto_Click" Visibility="Collapsed">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="⚡ AUTO ( ALL STOCKS )" FontSize="18" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                                <TextBlock Text="Scan into every stock you can access - the system picks the stock of each item" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#6B6770" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border x:Name="autoCheck" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#E4DDF0">
                                <TextBlock x:Name="autoCheckText" Text="" Foreground="White" FontSize="16" FontWeight="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="icStocks">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" Width="262" Height="128" CornerRadius="18" Margin="0,0,14,14"
                                        Background="White" BorderBrush="#ECE9F1" BorderThickness="2" Cursor="Hand"
                                        Opacity="{Binding CardOpacity}" MouseLeftButtonUp="Card_Click" Tag="{Binding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{Binding AccentBrush}"/>

                                        <Grid Grid.Row="1" Margin="16,10,12,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding Stock.Code}" FontSize="17" FontWeight="Black" Foreground="{StaticResource MainPurple}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,40,0" VerticalAlignment="Center"/>
                                                <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="{Binding CheckBrush}" Visibility="{Binding CheckVisibility}">
                                                    <TextBlock Text="{Binding CheckText}" Foreground="White" FontSize="15" FontWeight="Black"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Stock.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#6B6770"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="8" Padding="8,3" Background="#F1EEF6">
                                                        <TextBlock Text="{Binding Stock.Unit, StringFormat=UNIT : {0}}" FontSize="10" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                                                    </Border>
                                                    <Border CornerRadius="8" Padding="8,3" Background="#F1EEF6" Margin="6,0,0,0" Visibility="{Binding MainVisibility}">
                                                        <TextBlock Text="MAIN" FontSize="10" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- ★ คลังที่ตัดก่อนตอนสแกนออก (เมื่อสินค้าอยู่หลายคลัง) -->
                                                <Button Content="{Binding PriorityText}" Visibility="{Binding PriorityButtonVisibility}" Click="Priority_Click" Tag="{Binding}"
                                                        HorizontalAlignment="Right" Style="{StaticResource StkCardButton}" Foreground="{Binding PriorityForeground}"
                                                        ToolTip="SCAN OUT: use this stock first when an item is in several stocks"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                        <Setter TargetName="card" Property="Background" Value="#FBF9FE"/>
                                    </DataTrigger>
                                    <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtHint" FontSize="11" Foreground="#8A8490" FontWeight="SemiBold" Margin="2,0,14,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,8,26,22">
                <Button Content="CANCEL" Style="{StaticResource StkButton}" Background="#9E9E9E" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="btnSave" Content="SAVE" Style="{StaticResource StkButton}" Background="{StaticResource AccentPurple}" MinWidth="140" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
