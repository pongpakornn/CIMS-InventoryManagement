<Window x:Class="CIMS.Views.MonthPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose months" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 📤 เลือกเดือน (ทั้งหมด / บางเดือน) เช่น Export Forecast / Order / Delivery แยกชีทตามเดือน -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Border Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="txtTitle" Text="📤 EXPORT" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock x:Name="txtSub" Text="Choose the months" Foreground="#D0BCFF" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Cancel_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <StackPanel Margin="26,18,26,6">
                <Border Background="#F7F5FA" CornerRadius="12" Padding="14,10" BorderBrush="#E4DDF0" BorderThickness="1.5">
                    <CheckBox x:Name="chkAll" Content="ALL MONTHS" FontSize="14" FontWeight="Black" Foreground="#2D2A32" VerticalContentAlignment="Center"
                              Cursor="Hand" Click="All_Click"/>
                </Border>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <ItemsControl x:Name="icMonths">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="172" Margin="0,0,10,10" Background="White" CornerRadius="10" Padding="12,9" BorderBrush="#E4DDF0" BorderThickness="1.5">
                                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" FontSize="13" FontWeight="Bold" Foreground="#2D2A32"
                                              VerticalContentAlignment="Center" Cursor="Hand" Click="Month_Click"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="txtCount" FontSize="12" FontWeight="Bold" Foreground="#6F6878" Margin="2,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,26,22">
                <Button Content="CANCEL" Style="{StaticResource StkButton}" Background="#9E9E9E" Click="Cancel_Click"/>
                <Button x:Name="btnOk" Content="📤 EXPORT" Style="{StaticResource StkButton}" Background="#1976D2" Margin="10,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
