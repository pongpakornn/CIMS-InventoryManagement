<Window x:Class="CIMS.Views.ProductControlAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Registration - Admin" Width="1240" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 🛠 ADMIN ของหน้า Inventory Registration (Level 1 เท่านั้น): Sidebar พับเข้า / กางออกได้เหมือนหน้าหลัก
         STOCK DELETE / TABLE COLUMNS (ตารางของแต่ละคลัง) / QR CODE (รูปแบบ QR ที่ Export) -->
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,4,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Width="240" Background="{StaticResource PrimaryColor}" CornerRadius="21,0,0,21">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource PrimaryDark}" CornerRadius="21,0,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="🛠" FontSize="22" Foreground="White" VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                            <StackPanel x:Name="spBrand" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="ADMIN" FontWeight="ExtraBold" Foreground="White" FontSize="17"/>
                                <TextBlock Text="Inventory Registration" FontWeight="SemiBold" Foreground="#AAAAAA" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="txtLevel" Text="LEVEL 1 ONLY" Foreground="#66FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <StackPanel Margin="0,10,0,0">
                        <RadioButton x:Name="navDelete" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" ToolTip="STOCK DELETE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="lblDelete" Text="STOCK DELETE" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="navColumns" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" ToolTip="TABLE COLUMNS of each stock">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="lblColumns" Text="TABLE COLUMNS" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="navQr" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked" ToolTip="QR CODE format of each stock">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="lblQr" Text="QR CODE" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PrimaryColor}" CornerRadius="0,21,0,0" Padding="16,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Button Content="☰" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="22" HorizontalAlignment="Left"
                                Click="Toggle_Click" Cursor="Hand" ToolTip="Fold / unfold the sidebar"/>
                        <TextBlock x:Name="txtTitle" Text="STOCK DELETE" Foreground="White" FontSize="19" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Close_Click" ToolTip="CLOSE"/>
                    </Grid>
                </Border>
                <ContentControl x:Name="host" Grid.Row="1" Margin="26,20,26,22"/>
            </Grid>
        </Grid>
    </Border>
</Window>
