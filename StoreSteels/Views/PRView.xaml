<Page x:Class="CIMS.Views.PRView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Purchase Request" Background="Transparent"
      RenderTransformOrigin="0.5,0.5">

    <!-- Style -->
    <Page.Resources>
        <!-- Style : CyberInput -->
        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="1.5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Foreground="#AAA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style : AnimatedButton -->
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow" Background="Black" Opacity="0" CornerRadius="12" Margin="1,2,-1,-2"/>
                            <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style : CyberComboBox -->
        <Style x:Key="CyberComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <Border x:Name="border" CornerRadius="10" 
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="{TemplateBinding Padding}">
                                       <ContentPresenter x:Name="contentPresenter" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                       <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch" FontWeight="Bold" FontSize="13" Focusable="True" Visibility="Hidden" Foreground="{TemplateBinding Foreground}"/>
                                    </Grid>

                                    <Path x:Name="arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0" 
                      Stroke="#666" StrokeThickness="2" VerticalAlignment="Center" 
                      HorizontalAlignment="Center" IsHitTestVisible="False"/>

                                    <ToggleButton Grid.Column="1" Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2"
       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
       Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="White" 
            CornerRadius="10" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            MinWidth="{TemplateBinding ActualWidth}" 
            Margin="0,5,0,5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style : CyberComboBox -->
        <Style x:Key="CyberCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="mainBorder" 
                    CornerRadius="10" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1.5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="contentPresenter"
        IsHitTestVisible="False" 
        Content="{TemplateBinding SelectionBoxItem}" 
        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
        Margin="{TemplateBinding Padding}"
        VerticalAlignment="Center" 
        HorizontalAlignment="Left"/>
                                <TextBox x:Name="PART_EditableTextBox"
        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
        IsReadOnly="{TemplateBinding IsReadOnly}"
        Margin="{TemplateBinding Padding}"
        Style="{x:Null}" 
        Background="Transparent"
        BorderThickness="0"
        Focusable="True"
        VerticalAlignment="Center"
        Visibility="Hidden"/>

                                <Path Grid.Column="1" 
                      Data="M 0 0 L 4 4 L 8 0" 
                      Stroke="#AAA" 
                      StrokeThickness="2" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Center"/>
                            </Grid>

                            <ToggleButton Background="Transparent" 
                          BorderThickness="0" 
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" Margin="0,5,0,5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="mainBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Page.Resources>

    <!-- Style : Animation Page -->
    <Page.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="30"/>
    </Page.RenderTransform>

    <!-- Container : Body Responsive -->
    <Border x:Name="MainBorder" Background="White" CornerRadius="25" Padding="30" Margin="20" BorderBrush="#F0F0F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Container : Scrop Body -->
            <StackPanel Grid.Row="0">

                <!-- TextHeader : PURCHASE REQUISITION -->
                <TextBlock Text="PURCHASE REQUISITION" FontSize="30" FontWeight="Black" Foreground="{StaticResource MainPurple}" Margin="5,0,0,20"/>

                <!-- Grid Control 1 : Group InputBox -->
                <UniformGrid Columns="4">
                    
                    <!-- StackPanel : Date & TextBox Date -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Date" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <TextBox x:Name="txtPRDate" Text="{Binding CurrentDateDisplay, Mode=OneWay}" FontWeight="SemiBold" IsReadOnly="True" Background="#F0F0F0" Style="{StaticResource CyberInput}"/>
                    </StackPanel>

                    <!-- StackPanel : Requester & TextBox Requester -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Requester" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <!-- พิมพ์เองได้ / เลือกจากค่าที่เคยใช้ (กรองตามที่พิมพ์) -->
                        <ComboBox x:Name="txtRequester" Tag="REQUESTER" Style="{StaticResource CyberComboBox}" IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding RequesterSuggestions}" KeyUp="Lookup_KeyUp" GotKeyboardFocus="Lookup_GotKeyboardFocus"
                                  FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <!-- StackPanel : Product Name & TextBox Product Name -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Product Name" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <ComboBox x:Name="txtProductName" 
                          Style="{StaticResource CyberComboBox}" 
                          IsEditable="True" 
                          IsTextSearchEnabled="False"
                          ItemsSource="{Binding ProductSuggestions}"
                          KeyUp="txtProductName_KeyUp"
                          FontWeight="Bold" 
                          FontSize="13"
                          Tag="Type to search (top 5)...">

                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <!-- StackPanel : Qty & TextBox Qty -->
                    <StackPanel Margin="8">
                        <TextBlock Text="QTY" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <TextBox x:Name="txtQTY" Style="{StaticResource CyberInput}" FontWeight="Bold" Tag="0"/>
                    </StackPanel>
                    
                </UniformGrid>
                <!-- End : GridControl 1 -->

                <!-- Grid Control 2 : Group InputBox -->
                <UniformGrid Columns="4" Margin="0,5,0,0">

                    <!-- StackPanel : Department & TextBox Department -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Department" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <ComboBox x:Name="txtDept" Tag="DEPT" Style="{StaticResource CyberComboBox}" IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding DeptSuggestions}" KeyUp="Lookup_KeyUp" GotKeyboardFocus="Lookup_GotKeyboardFocus"
                                  FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <!-- StackPanel : Remark & TextBox Remark -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Remark" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <ComboBox x:Name="txtRemark" Tag="REMARK" Style="{StaticResource CyberComboBox}" IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding RemarkSuggestions}" KeyUp="Lookup_KeyUp" GotKeyboardFocus="Lookup_GotKeyboardFocus"
                                  FontWeight="Bold" FontSize="13"/>
                    </StackPanel>

                    <!-- StackPanel : Target Dept & TextBox Target Dept -->
                    <StackPanel Margin="8">
                        <TextBlock Text="Target Dept" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="14"/>
                        <ComboBox x:Name="txtTargetDept" Tag="TARGET" Style="{StaticResource CyberComboBox}" IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding TargetSuggestions}" KeyUp="Lookup_KeyUp" GotKeyboardFocus="Lookup_GotKeyboardFocus"
                                  FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <!-- StackPanel : Button SubmitPR & Button Export -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8">
                        <Button x:Name="btnSubmitPR" Content="SUBMIT PR" Style="{StaticResource AnimatedButton}" Background="#4CAF50" Width="110" Height="45" FontWeight="Black" FontSize="12" Click="SubmitPR_Click"/>
                        <!-- EXPORT ย้ายไปอยู่ในหน้าต่าง APPROVED LIST (ติ๊กเลือกรายการแล้ว Export) -->
                        <Button x:Name="btnExport" Content="📋 APPROVED LIST" Style="{StaticResource AnimatedButton}" Background="#2196F3" Width="160" Height="45" FontWeight="Black" FontSize="12" Margin="8,0,0,0" Click="ApprovedList_Click"/>
                    </StackPanel>
                    
                </UniformGrid>
                <!-- End : GridControl 2 -->
                
            </StackPanel>
            <!-- End : Container -->

            <!-- Grid Control 3 : Function SearchPR -->
            <Grid Grid.Row="1" Margin="8,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 🗑 DELETE ALL: ลบ PR ทุกรายการที่แสดงในตาราง (ตามคำค้น) - Admin Level 1 เท่านั้น -->
                <Button x:Name="btnDeleteAllPR" Grid.Column="3" Content="🗑 DELETE ALL" Style="{StaticResource AnimatedButton}" Background="#C62828"
                        Width="160" Height="48" FontSize="13" Margin="12,0,0,0" Click="DeleteAllPR_Click" Visibility="Collapsed"
                        ToolTip="Delete every PR shown in the table (admin only)"/>

                <!-- Function : TextBox SearchPR -->
                <!-- ⚙ PR SETTINGS: เลือกคลังที่แสกนออกแล้วสร้าง PR อัตโนมัติ (ผู้ดูแลระบบ / ผู้อนุมัติ PR เท่านั้น) -->
                <Button x:Name="btnPrSettings" Grid.Column="2" Content="⚙ PR SETTINGS" Style="{StaticResource AnimatedButton}"
                        Width="160" Height="48" FontSize="13" Margin="12,0,0,0" Click="PrSettings_Click" Visibility="Collapsed"/>
                <TextBox x:Name="txtSearchPR" Style="{StaticResource CyberInput}" Tag="Search by product name or status..." Height="48" FontSize="14" KeyDown="txtSearchPR_KeyDown" TextChanged="txtSearchPR_TextChanged"/>
                
                <!-- Function : Button SearchPR -->
                <Button Grid.Column="1" 
                    Style="{StaticResource AnimatedButton}" 
                    Width="160" 
                    Height="48" FontSize="13"
                    Margin="12,0,0,0" 
                    Click="SearchPR_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border Background="White">
                                <Border.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/64magnifier_FF.png" Stretch="Uniform"/>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>

                        <TextBlock Text="SEARCH DATA" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center" 
                   Foreground="White"/>
                    </StackPanel>
                </Button>
                
            </Grid>
            <!-- End : GridControl 3 -->

            <!-- DataGrid : PRView & Action -->
            <DataGrid x:Name="dgPR" Grid.Row="2" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" RowHeight="55" IsReadOnly="True" VerticalAlignment="Top" UseLayoutRounding="True"
                SnapsToDevicePixels="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F5F5F5" HeadersVisibility="Column" HorizontalScrollBarVisibility="Disabled" ColumnWidth="*" EnableRowVirtualization="True"
                EnableColumnVirtualization="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding PRHistory}">

                <!-- DataGridHeader : Style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <!-- End : DataGridHeader -->

                <!-- DataGridHeader : Function CheckBox -->
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkSelectAllPR" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectAllPR_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- End : Function CheckBox -->

                    <!-- DataGridHeader : Function REQUESTER -->
                    <DataGridTextColumn Header="REQUESTER" Binding="{Binding Requester}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- End : Function REQUESTER -->

                    <!-- DataGridHeader : Function PRODUCT NAME -->
                    <DataGridTemplateColumn Header="PRODUCT NAME" Width="2.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding PartName}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="Bold" FontSize="13" Padding="15,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- End : Function PRODUCT NAME -->

                    <!-- DataGridHeader : Function QTY -->
                    <DataGridTextColumn Header="QTY" Binding="{Binding QTY}" Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- End : Function QTY -->

                    <!-- DataGridHeader : Function STATUS -->
                    <DataGridTemplateColumn Header="STATUS" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="statusBorder" CornerRadius="15" Padding="13,6" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="80">
                                    <TextBlock x:Name="statusText" Text="{Binding Status}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#FFF8E1"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#FF8F00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#E8F5E9"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#FFEBEE"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- End : Function STATUS -->

                    <!-- DataGridHeader : Function DATE -->
                    <DataGridTextColumn Header="DATE" Binding="{Binding PRDate, StringFormat='dd/MM/yyyy'}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- End : Function DATE -->

                    <!-- DataGridHeader : Function Group Action -->
                    <DataGridTemplateColumn Header="ACTION" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                
                                <!-- Button : Group Action -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    
                                    <!-- Function : VIEW Action -->
                                    <Button Content="VIEW" Style="{StaticResource AnimatedButton}" Height="29" Width="65" Margin="0,0,5,0" FontSize="11" FontWeight="Black" Click="ViewAction_Click" Background="{StaticResource AccentPurple}"/>
                                   
                                    <!-- Function : Approve Action -->
                                    <Button x:Name="btnApprove" Content="APPROVE" Style="{StaticResource AnimatedButton}" Height="29" Width="71" Margin="0,0,5,0" FontSize="11" FontWeight="Black" Click="Approve_Click" Background="#4CAF50" Visibility="Collapsed"/>
                                    
                                    <!-- Function : Reject Action -->
                                    <Button x:Name="btnReject" Content="REJECT" Style="{StaticResource AnimatedButton}" Height="29" Width="68" FontSize="11" FontWeight="Black" Click="Reject_Click" Background="#F44336" Visibility="Collapsed"/>
                                
                                </StackPanel>
                                <!-- End : Group Action -->

                                <!-- Public : Function Action -->
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="Waiting"/>
                                            <!-- 🔐 APPROVE / REJECT = สิทธิ์ PR แบบ APPROVE (Level 1 ได้เสมอ) -->
                                            <Condition Binding="{Binding DataContext.CurrentUser.CanApprovePR, RelativeSource={RelativeSource AncestorType=Page}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <!-- Public Property Function : Approve -->
                                        <Setter TargetName="btnApprove" Property="Visibility" Value="Visible"/>
                                        
                                        <!-- Public Property Function : Reject -->
                                        <Setter TargetName="btnReject" Property="Visibility" Value="Visible"/>
                                    
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                                <!-- End : Public Function Action -->
                                
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- End : Function Group Action -->
                    
                </DataGrid.Columns>
            </DataGrid>
        
        </Grid>
    </Border>
</Page>