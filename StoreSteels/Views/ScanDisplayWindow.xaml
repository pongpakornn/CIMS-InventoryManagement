<Window x:Class="CIMS.Views.ScanDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Display" Width="860" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 🏷️ เลือกค่าที่แสดงในช่อง PRODUCT CODE ของหน้า Multi-Scanner / HISTORY ต่อคลัง (แสดงผลอย่างเดียว) -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🏷️ SCAN DISPLAY" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="Choose what each stock shows as PRODUCT CODE in the scan tables and HISTORY (display only - nothing else changes)"
                                   Foreground="#D0BCFF" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Cancel_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="26,16,26,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icStocks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F7F5FA" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontWeight="Black" FontSize="15" Foreground="#2D2A32"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#8A8490" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Height="42" Style="{StaticResource StkCombo}" ItemsSource="{Binding Options}"
                                              SelectedValuePath="Key" SelectedValue="{Binding Selected, Mode=TwoWay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="26,12,26,20">
                <TextBlock Text="BARCODE #n = field n of the raw label (same numbers as BARCODE FORMATS). If a label does not match, PRODUCT CODE is shown."
                           FontSize="11" FontWeight="SemiBold" Foreground="#8A8490" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,300,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Style="{StaticResource StkButton}" Background="#9E9E9E" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnSave" Content="SAVE DISPLAY" Style="{StaticResource StkButton}" Background="#2E7D32" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
