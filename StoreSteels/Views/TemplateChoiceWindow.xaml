<Window x:Class="CIMS.Views.TemplateChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Template Excel" Width="660" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 📄 เลือกว่าจะสร้างไฟล์ Template ของปุ่ม Import ไหน (หน้าที่มีปุ่ม Import หลายปุ่ม) -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Border Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="📄 TEMPLATE EXCEL" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock x:Name="txtSub" Text="Choose the import you want to prepare a file for" Foreground="#D0BCFF" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Cancel_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="icOptions" Margin="26,18,26,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Option_Click" Tag="{Binding Key}" Cursor="Hand" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#F7F5FA" CornerRadius="14" Padding="18,14" BorderBrush="#E4DDF0" BorderThickness="1.5">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                            <Setter TargetName="bd" Property="Background" Value="#F1ECFA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="#2D2A32"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" FontWeight="SemiBold" Foreground="#6F6878" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding UseWith}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="›" FontSize="30" FontWeight="Bold" Foreground="#B8AFC6" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <Button Content="CANCEL" Style="{StaticResource StkButton}" Background="#9E9E9E" HorizontalAlignment="Right" Margin="0,0,26,22" Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</Window>
