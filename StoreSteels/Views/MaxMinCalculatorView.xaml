<Page x:Class="CIMS.Views.MaxMinCalculatorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Max-Min Calculator" Background="Transparent">

    <!-- ย้ายมาจาก StorePC (MaxMinCalculatorView) + เลือกคลัง / สูตรคำนวณ / วันทำงานของลูกค้า -->
    <Page.Resources>
        <SolidColorBrush x:Key="DeepDark" Color="#1A1C1E"/>
        <SolidColorBrush x:Key="CyberPink" Color="#D0BCFF"/>

        <Style x:Key="CalcInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="1.5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Foreground="#AAA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F1F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow" Background="Black" Opacity="0" CornerRadius="12" Margin="1,2,-1,-2"/>
                            <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomerHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel Margin="0,0,0,5">
                            <Border Background="#F3E5F5" CornerRadius="5" Height="38" BorderBrush="{StaticResource MainPurple}" BorderThickness="2,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="👥 CUSTOMER : " FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="15" Margin="5,0,0,0"/>
                                    <Border Background="{StaticResource MainPurple}" CornerRadius="12" Padding="12,6" Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} ITEMS'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ItemsPresenter Margin="0,5,0,5"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border Background="White" CornerRadius="25" Padding="30,26" Margin="20" BorderBrush="#F0F0F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- หัวข้อ + คลัง / สูตรที่ใช้ / AUTO CALC -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📐 MAX-MIN CALCULATOR" FontSize="24" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                    <TextBlock Text="Set MAX / MIN (DAYS) per part - the system calculates MAX / MIN of Store (Max-Min) from Order / Workdays" FontSize="12" FontWeight="SemiBold" Foreground="#8A8490" Margin="2,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="STOCK :" FontWeight="Bold" FontSize="14" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbStock" Width="200" Height="42" Style="{StaticResource StkCombo}" SelectionChanged="cbStock_SelectionChanged" Margin="0,0,16,0"/>
                    <TextBlock Text="FORMULA :" FontWeight="Bold" FontSize="14" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbFormula" Width="230" Height="42" Style="{StaticResource StkCombo}" SelectionChanged="Setting_Changed" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkAutoCalc" Content="AUTO CALC" Style="{StaticResource StkChip}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Recalculate this stock automatically after IMPORT FORECAST &amp; ORDER" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <Button x:Name="btnSaveSetting" Content="💾 SAVE" Style="{StaticResource CalcButton}" Background="{StaticResource AccentPurple}" IsEnabled="False" Click="SaveSetting_Click"/>
                </StackPanel>
            </Grid>

            <!-- ปุ่มทำงาน -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button x:Name="btnFormula" Content="⚙ FORMULAS" Style="{StaticResource CalcButton}" Margin="0,0,8,0" Click="Formula_Click"/>
                <Button x:Name="btnWorkdays" Content="📅 WORKDAYS" Style="{StaticResource CalcButton}" Margin="0,0,8,0" Click="Workdays_Click"/>
                <Button x:Name="btnImportDays" Content="📥 IMPORT SET MAX MIN" Style="{StaticResource CalcButton}" Margin="0,0,8,0" Click="ImportDays_Click"/>
                <Button x:Name="btnExport" Content="📤 EXPORT" Style="{StaticResource CalcButton}" Margin="0,0,8,0" Click="Export_Click"
                        ToolTip="Export PART NO / PRODUCT NAME / MAX (DAYS) / MIN (DAYS) of the table - edit and IMPORT SET MAX MIN back"/>
                <Button x:Name="btnImportForecast" Content="📊 IMPORT FORECAST &amp; ORDER" Style="{StaticResource CalcButton}" Margin="0,0,8,0" Click="ImportForecast_Click"/>
                <Button x:Name="btnCalculate" Content="⚡ CALCULATE NOW" Style="{StaticResource CalcButton}" Background="{StaticResource AccentPurple}" Click="Calculate_Click"/>
            </WrapPanel>
            <!-- สถานะสูตรของคลัง -->
            <Border Grid.Row="2" CornerRadius="14" Background="#F7F4FC" BorderBrush="#E4DDF0" BorderThickness="1" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="bdAuto" CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Background="#9E9E9E">
                        <TextBlock x:Name="txtAuto" Text="AUTO CALC : OFF" Foreground="White" FontSize="11" FontWeight="Black"/>
                    </Border>
                    <TextBlock x:Name="txtFormula" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#49454F" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtLast" Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="#8A8490" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ฟอร์มแก้ไข MAX / MIN (DAYS) (กด EDIT ในตาราง) -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="CUSTOMER" FontWeight="UltraBold" Foreground="#757575" Margin="5,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtCust" IsReadOnly="True" Style="{StaticResource CalcInput}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="PART NO" FontWeight="UltraBold" Foreground="#757575" Margin="5,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtPartNo" IsReadOnly="True" Style="{StaticResource CalcInput}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="PRODUCT NAME" FontWeight="UltraBold" Foreground="#757575" Margin="5,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtName" IsReadOnly="True" Style="{StaticResource CalcInput}" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="MAX (DAYS)" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtDayMax" IsReadOnly="True" Style="{StaticResource CalcInput}" MaxLength="3" PreviewTextInput="Digits_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="4">
                    <TextBlock Text="MIN (DAYS)" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="12"/>
                    <TextBox x:Name="txtDayMin" IsReadOnly="True" Style="{StaticResource CalcInput}" MaxLength="3" PreviewTextInput="Digits_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,4,4">
                    <Button Content="CLEAR" Style="{StaticResource CalcButton}" Margin="0,0,6,0" Click="Clear_Click"/>
                    <Button x:Name="btnSave" Content="💾 SAVE" Style="{StaticResource CalcButton}" Background="{StaticResource AccentPurple}" IsEnabled="False" Click="Save_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Style="{StaticResource CalcInput}" Height="44" Tag="Search Customer, Part No, Part A, PD Code or Product Name..." TextChanged="txtSearch_TextChanged"/>
                <TextBlock x:Name="txtCount" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="14,0,4,0"/>
            </Grid>

            <DataGrid x:Name="dgCalc" Grid.Row="5"
                      AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" RowHeight="50"
                      FontSize="13" FontWeight="Bold" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F5F5F5"
                      HeadersVisibility="Column" SelectionUnit="FullRow" CanUserAddRows="False"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      ScrollViewer.ScrollChanged="dgCalc_ScrollChanged">
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource CustomerHeaderStyle}"/>
                </DataGrid.GroupStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <Style x:Key="CenterGridText" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="0.5*" MinWidth="55" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="PART NO" Binding="{Binding PartNo}" Width="1.5*" MinWidth="120" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding PartName}" Width="2.6*" MinWidth="180" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="PACKSIZE" Binding="{Binding PackSize, StringFormat=N0}" Width="0.9*" MinWidth="100" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="MAX (DAYS)" Binding="{Binding DayMax}" Width="0.9*" MinWidth="90" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="MIN (DAYS)" Binding="{Binding DayMin}" Width="0.9*" MinWidth="90" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn x:Name="colQtyMax" Header="MAX (BOX)" Binding="{Binding QtyMaxText}" Width="0.9*" MinWidth="95" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn x:Name="colQtyMin" Header="MIN (BOX)" Binding="{Binding QtyMinText}" Width="0.9*" MinWidth="95" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTemplateColumn Header="ACTION" Width="1.3*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="EDIT" Style="{StaticResource RowButton}" Background="{StaticResource AccentPurple}" Foreground="White" Margin="0,0,6,0"
                                            Click="EditRow_Click" Tag="{Binding}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                    <Button Content="RESET" Style="{StaticResource RowButton}" Background="{StaticResource CyberPink}" Foreground="{StaticResource DeepDark}"
                                            Click="ResetRow_Click" Tag="{Binding}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtEmpty" Grid.Row="5" Text="NO PRODUCT IN THIS STOCK" FontSize="16" FontWeight="Bold" Foreground="#AAA"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,60,0,0"/>
        </Grid>
    </Border>
</Page>
