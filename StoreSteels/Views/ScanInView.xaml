<Page x:Class="CIMS.Views.ScanInView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:CIMS.Helpers"
      Title="Multi-Scanner ( IN )" Background="Transparent"
      RenderTransformOrigin="0.5,0.5">

    <!-- Style -->
    <Page.Resources>
        <!-- Style TextBox -->
        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="1.5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style AnimationButton -->
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style DataGridView : Row -->
        <Style x:Key="CenterBoldColumnStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Style DataGridView : SummaryStock -->
        <Style x:Key="SummaryStockStyle" TargetType="TextBlock" BasedOn="{StaticResource CenterBoldColumnStyle}">
            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </Page.Resources>

    <Page.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="30"/>
    </Page.RenderTransform>

    <Border x:Name="MainBorder" 
            Background="White" 
            CornerRadius="25" 
            Padding="30" 
            Margin="20"
            BorderBrush="#F0F0F0"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Function Multi-Scanner -->
            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding ScanTitle}" FontSize="26" FontWeight="Black" Foreground="{StaticResource MainPurple}" Margin="5,0,15,10" VerticalAlignment="Center"/>

                        <!-- 📤 ป้ายไฟแจ้งเตือนโหมดสแกนออก -->
                        <Border Background="#7B1FA2" CornerRadius="8" Padding="10,4" Height="28" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding ScanOutBannerVisibility}">
                            <TextBlock Text="📤 SCAN OUT MODE ACTIVE" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>

                        <!-- 🚀 ป้ายไฟแจ้งเตือนโหมด Test -->
                        <Border Background="#ED6C02" CornerRadius="8" Padding="10,4" Height="28" VerticalAlignment="Center" Visibility="{Binding TestBannerVisibility}">
                            <TextBlock Text="⚠️ TEST MODE ACTIVE (NOT SAVED)" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>

                        <!-- 🔄 ป้ายไฟแจ้งเตือนโหมดคืนเหล็ก -->
                        <Border Background="#0288D1" CornerRadius="8" Padding="10,4" Height="28" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding ReturnBannerVisibility}">
                            <TextBlock Text="🔄 RETURN MODE ACTIVE" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>

                        <!-- 🔢 ป้ายไฟแจ้งเตือนโหมดสแกนเศษ -->
                        <Border Background="#00897B" CornerRadius="8" Padding="10,4" Height="28" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding RemainderBannerVisibility}">
                            <TextBlock Text="🔢 REMAINDER MODE (TYPE QTY)" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- ปุ่มสลับโหมด สแกนออก / คืนเหล็ก / Test (Focusable=False: กดแล้วโฟกัสยังอยู่ที่ช่องสแกน ยิงต่อได้ทันที) -->
                    <!-- จอเล็ก: ชื่อหน้าแสดงเต็มเสมอ ปุ่มขึ้นแถวใหม่เองเมื่อที่ไม่พอ (จอ Full HD อยู่แถวเดียวเหมือนเดิม) -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="{Binding ScanOutButtonText}"
                                Command="{Binding ToggleScanOutModeCommand}"
                                Background="{Binding ScanOutButtonBackground}"
                                Visibility="{Binding ScanOutButtonVisibility}"
                                Style="{StaticResource AnimatedButton}" Focusable="False"
                                Width="160" Height="38" FontSize="13" Margin="0,0,10,6"/>

                        <Button Content="{Binding ReturnButtonText}"
                                Command="{Binding ToggleReturnModeCommand}"
                                Background="{Binding ReturnButtonBackground}"
                                Visibility="{Binding ReturnButtonVisibility}"
                                Style="{StaticResource AnimatedButton}" Focusable="False"
                                Width="160" Height="38" FontSize="13" Margin="0,0,10,6"/>

                        <Button Content="{Binding RemainderButtonText}"
                                Command="{Binding ToggleRemainderModeCommand}"
                                Background="{Binding RemainderButtonBackground}"
                                Visibility="{Binding RemainderButtonVisibility}"
                                Style="{StaticResource AnimatedButton}" Focusable="False" ToolTip="Scan then type the qty yourself (no box count)"
                                Width="170" Height="38" FontSize="13" Margin="0,0,10,6"/>

                        <Button Content="{Binding TestButtonText}"
                                Command="{Binding ToggleTestModeCommand}"
                                Background="{Binding TestButtonBackground}"
                                Style="{StaticResource AnimatedButton}" Focusable="False"
                                Width="160" Height="38" FontSize="13" Margin="0,0,0,6"/>
                        <!-- 🕘 ประวัติการสแกน (TURBO ทำงานตลอด ไม่มีปุ่มแล้ว) -->
                        <Button Content="🕘 HISTORY" Click="History_Click"
                                Background="{StaticResource MainPurple}"
                                Style="{StaticResource AnimatedButton}" Focusable="False"
                                Width="130" Height="38" FontSize="13" Margin="10,0,0,6"/>
                        <!-- 🏷️ เลือกค่าที่แสดงแทนรหัสต่อคลัง (PART A / PART NO / Barcode #n ...) -->
                        <Button Content="🏷️ DISPLAY" Click="ScanDisplay_Click"
                                Background="#49454F" Visibility="{Binding DisplayButtonVisibility}"
                                Style="{StaticResource AnimatedButton}" Focusable="False" ToolTip="Choose what each stock shows as PRODUCT CODE"
                                Width="120" Height="38" FontSize="13" Margin="10,0,0,6"/>
                        <!-- ✏️ แก้ไข / ลบรายการสแกน (Admin Level 1 เท่านั้น) -->
                        <Button Content="✏️ ADJUST SCAN" Click="AdjustScan_Click"
                                Background="#B3261E" Visibility="{Binding AdjustButtonVisibility}"
                                Style="{StaticResource AnimatedButton}" Focusable="False"
                                Width="150" Height="38" FontSize="13" Margin="10,0,0,6"/>
                    </WrapPanel>
                </Grid>

                <Separator Background="#EEE" Margin="0,5,0,0" Height="1.5"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SCAN BARCODE" FontWeight="Bold" Foreground="#999" Margin="5,10,0,6" FontSize="13"/>
                        <TextBox x:Name="txtBarcodeInput" Style="{StaticResource CyberInput}" 
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                                 KeyDown="txtBarcodeInput_KeyDown" TextChanged="txtBarcodeInput_TextChanged" PreviewKeyDown="txtBarcodeInput_PreviewKeyDown"
                                 HorizontalContentAlignment="Center" FontSize="18" FontWeight="Bold" MaxLength="0"/>
                    </StackPanel>

                    <!-- 🏬 เลือกคลังที่แสกน: กดแล้วเด้งการ์ดคลัง (1 คลัง / หลายคลังสแกนร่วมกัน / AUTO) - จำค่าไว้ในเครื่อง -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="STOCK" FontWeight="Bold" Foreground="#999" Margin="5,10,0,6" FontSize="13"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnScanStocks" Width="360" Height="42" Focusable="False" Click="ScanStocks_Click"
                                    Style="{StaticResource StkButton}" Background="{StaticResource MainPurple}" HorizontalContentAlignment="Left">
                                <Grid Width="326">
                                    <TextBlock Text="{Binding ScopeText}" FontWeight="Black" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" HorizontalAlignment="Right" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <TextBlock Text="{Binding ScopeSubText}" Visibility="{Binding ScopeSubVisibility}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Function Grid : TextBlock Sceen -->
            <Border Grid.Row="1" Background="#E8F5E9" CornerRadius="15" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="100" Height="100" Background="White" CornerRadius="12" Margin="5,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#000" Opacity="0.06" ShadowDepth="1"/>
                        </Border.Effect>

                        <Image Source="{Binding ShowProductImage, UpdateSourceTrigger=PropertyChanged}" 
                               Stretch="Uniform" 
                               Margin="8"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PART DESCRIPTION" FontSize="12" Foreground="#558B2F" FontWeight="ExtraBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ShowName, FallbackValue='Waiting for scan...'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MainPurple}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding ShowCode, FallbackValue='Code: -'}" FontSize="14" Foreground="#666" FontWeight="Bold" VerticalAlignment="Center"/>
                            <!-- คลังที่รายการล่าสุดลงจริง -->
                            <Border Background="{StaticResource MainPurple}" CornerRadius="8" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowStockVisibility}">
                                <TextBlock Text="{Binding ShowStock, StringFormat='→ {0}'}" Foreground="White" FontSize="12" FontWeight="Black"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding QtyLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ShowQty, FallbackValue='0'}" FontSize="42" FontWeight="Black" Foreground="{StaticResource SuccessGreen}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Function Grid : DataGridView -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" Margin="5,0,0,10">
                        <!-- หัวตารางโหมดปกติ -->
                        <TextBlock Text="DAILY SCAN ( IN / OUT )" FontWeight="ExtraBold" Foreground="#888">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTestMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- หัวตารางโหมด Test -->
                        <TextBlock Text="TEST SCAN RESULT (NOT SAVED)" FontWeight="ExtraBold" Foreground="#ED6C02" Visibility="{Binding TestBannerVisibility}"/>
                    </Grid>

                    <!-- 1. ตารางสแกนจริง (แสดงเมื่อไม่ได้อยู่ในโหมด Test) -->
                    <DataGrid x:Name="dgToday" ItemsSource="{Binding ScannedItems}" AutoGenerateColumns="False" FontSize="14" Focusable="False" 
                              IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeight="50" HeadersVisibility="Column" SelectionMode="Single"  
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#F5F5F5" VerticalGridLinesBrush="#EAEAEA" SelectionUnit="Cell"
                              HorizontalScrollBarVisibility="Disabled" ColumnWidth="*">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTestMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT CODE" Binding="{Binding CodeLabel}" Width="1.8*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="0.8*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <!-- สถานะ: IN (ปกติ) / RETURN (คืนเหล็ก) / OUT (สแกนออก) - แยกสีให้ดูออกชัดเจน -->
                            <DataGridTemplateColumn Header="STATUS" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="15" Padding="13,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="RETURN">
                                                            <Setter Property="Background" Value="#E1F5FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OUT">
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="Bold" FontSize="13" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="IN"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="RETURN">
                                                                <Setter Property="Text" Value="RETURN"/>
                                                                <Setter Property="Foreground" Value="#0288D1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="OUT">
                                                                <Setter Property="Text" Value="OUT"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DATETIME" Binding="{Binding UpdateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="1.8*" FontSize="16" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 2. 🚀 ตารางที่ 2: ตารางแสดงผลเฉพาะโหมด TEST (บันทึกลอย) สลับขึ้นมาแทนเมื่อกด Test -->
                    <DataGrid x:Name="dgTest" ItemsSource="{Binding TestScannedItems}" AutoGenerateColumns="False" FontSize="14" Focusable="False" 
                              IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeight="50" HeadersVisibility="Column" SelectionMode="Single"  
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#F5F5F5" VerticalGridLinesBrush="#EAEAEA" SelectionUnit="Cell"
                              HorizontalScrollBarVisibility="Disabled" ColumnWidth="*" Visibility="{Binding TestBannerVisibility}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#ED6C02"/>
                                <!-- หัวตารางสีส้มสำหรับแยกแยะโหมด Test -->
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT CODE" Binding="{Binding CodeLabel}" Width="1.8*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="0.8*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTemplateColumn Header="STATUS" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="15" Padding="13,6" Background="#FFF3E0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="TEST" Foreground="#ED6C02" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DATETIME" Binding="{Binding UpdateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="1.8*" FontSize="16" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Daily Stock Movement Summary (ตารางฝั่งขวา คงเดิม) -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Daily Stock Movement Summary" FontWeight="ExtraBold" Foreground="#888" FontSize="13" Margin="5,0,0,10"/>
                    <DataGrid x:Name="dgHistory" ItemsSource="{Binding HistoryItems}" AutoGenerateColumns="False" Focusable="False" SelectionUnit="Cell"
                              IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeight="50" FontSize="14" SelectionMode="Single" 
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#F5F5F5" HeadersVisibility="Column" VerticalGridLinesBrush="#EAEAEA"
                              HorizontalScrollBarVisibility="Disabled" ColumnWidth="*">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT CODE" Binding="{Binding CodeLabel}" Width="1.9*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="IN (FREQ.)" Binding="{Binding InCount}" Width="0.9*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="OUT (FREQ.)" Binding="{Binding OutCount}" Width="1.1*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="IN (QTY)" Binding="{Binding TotalInQty}" Width="0.9*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="OUT (QTY)" Binding="{Binding TotalOutQty}" Width="1.0*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            <DataGridTextColumn Header="INVENTORY BALANCE" Binding="{Binding FinalStock}" Width="1.8*" ElementStyle="{StaticResource SummaryStockStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
