<!--<Page x:Class="CIMS.Views.ScanInView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Multi-Scanner ( IN )" Background="Transparent"
      RenderTransformOrigin="0.5,0.5">

    --><!-- Style --><!--
    <Page.Resources>
        <SolidColorBrush x:Key="MainPurple" Color="#49454F"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#6750A4"/>

        --><!-- Style TextBox --><!--
        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="1.5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SuccessGreen}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        --><!-- Style AnimationButton --><!--
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        --><!-- Style DataGridView : Row --><!--
        <Style x:Key="CenterBoldColumnStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        --><!-- Style DataGridView : SummaryStock --><!--
        <Style x:Key="SummaryStockStyle" TargetType="TextBlock" BasedOn="{StaticResource CenterBoldColumnStyle}">
            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
    </Page.Resources>
    --><!-- End Function -->

    <!-- Function Animation Control --><!--
    <Page.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="30"/>
    </Page.RenderTransform>
    --><!-- End Function -->

    <!-- Function ContainerBody Control --><!--
    <Border x:Name="MainBorder" 
            Background="White" 
            CornerRadius="25" 
            Padding="30" 
            Margin="20"
            BorderBrush="#F0F0F0"
            BorderThickness="1">

        <Grid>
            --><!-- ResponSive Function --><!--
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            --><!-- End Function -->

            <!-- Function Multi-Scanner --><!--
            <StackPanel Grid.Row="0">
                <TextBlock Text="║▌║║▌║ MULTI-SCANNER ( IN )" FontSize="26" FontWeight="Black" Foreground="{StaticResource MainPurple}" Margin="5,0,0,10"/>
                <Separator Background="#EEE" Margin="0,0,0,0" Height="1.5"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SCAN BARCODE" FontWeight="Bold" Foreground="#999" Margin="5,10,0,6" FontSize="13"/>
                        <TextBox x:Name="txtBarcodeInput" Style="{StaticResource CyberInput}" 
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                                 KeyDown="txtBarcodeInput_KeyDown" TextChanged="txtBarcodeInput_TextChanged" PreviewKeyDown="txtBarcodeInput_PreviewKeyDown"
                                 HorizontalContentAlignment="Center" FontSize="18" FontWeight="Bold" MaxLength="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            --><!-- End Function -->

            <!-- Function Grid : TextBlock Sceen --><!--
            <Border Grid.Row="1" Background="#E8F5E9" CornerRadius="15" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="100" Height="100" Background="White" CornerRadius="12" Margin="5,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#000" Opacity="0.06" ShadowDepth="1"/>
                        </Border.Effect>

                        <Image Source="{Binding ShowProductImage, UpdateSourceTrigger=PropertyChanged}" 
                       Stretch="Uniform" 
                       Margin="8"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PART DESCRIPTION" FontSize="12" Foreground="#558B2F" FontWeight="ExtraBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ShowName, FallbackValue='Waiting for scan...'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MainPurple}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ShowCode, FallbackValue='Code: -'}" FontSize="14" Foreground="#666" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="QTY IN" FontSize="11" Foreground="#666" HorizontalAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ShowQty, FallbackValue='0'}" FontSize="42" FontWeight="Black" Foreground="{StaticResource SuccessGreen}"/>
                    </StackPanel>
                </Grid>
            </Border>
            --><!-- End Function -->

            <!-- Function Grid : DataGridView --><!--
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="DAILY INCOMING" FontWeight="ExtraBold" Foreground="#888" Margin="5,0,0,10"/>
                    <DataGrid x:Name="dgToday" ItemsSource="{Binding ScannedItems}" AutoGenerateColumns="False" FontSize="14" Focusable="False" 
                  IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeight="50" HeadersVisibility="Column" SelectionMode="Single"  
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#F5F5F5" VerticalGridLinesBrush="#EAEAEA" SelectionUnit="Cell"
                  HorizontalScrollBarVisibility="Disabled" ColumnWidth="*">

                        --><!-- Function DataGrid : HeaderColumn --><!--
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        --><!-- End Function --><!--

                        <DataGrid.Columns>

                            --><!-- Function HeaderColumn : Product Code --><!--
                            <DataGridTextColumn Header="PRODUCT CODE" Binding="{Binding PartACode}" Width="1.8*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            --><!-- End Function -->

                            <!-- Function HeaderColumn : QTY --><!--
                            <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="0.8*" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            --><!-- End Function -->

                            <!-- Function HeaderColumn : STATUS --><!--
                            <DataGridTemplateColumn Header="STATUS" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="15" Padding="13,6" Background="#E8F5E9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="IN" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            --><!-- End Function --><!--

                            <DataGridTextColumn Header="DATETIME" Binding="{Binding UpdateTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="1.8*" FontSize="16" ElementStyle="{StaticResource CenterBoldColumnStyle}"/>
                            --><!-- End Function --><!--
                            
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Daily Stock Movement Summary" FontWeight="ExtraBold" Foreground="#888" FontSize="13" Margin="5,0,0,10"/>
                    <DataGrid x:Name="dgHistory" ItemsSource="{Binding HistoryItems}" AutoGenerateColumns="False" Focusable="False" SelectionUnit="Cell"
              IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeight="50" FontSize="14" SelectionMode="Single" 
              GridLinesVisibility="All" HorizontalGridLinesBrush="#F5F5F5" HeadersVisibility="Column" VerticalGridLinesBrush="#EAEAEA"
              HorizontalScrollBarVisibility="Disabled" ColumnWidth="*">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#EEE"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="PRODUCT CODE" Binding="{Binding PartACode}" Width="1.9*" 
                                ElementStyle="{StaticResource CenterBoldColumnStyle}"/>

                            <DataGridTextColumn Header="IN (FREQ.)" Binding="{Binding InCount}" Width="0.9*" 
                                ElementStyle="{StaticResource CenterBoldColumnStyle}"/>

                            <DataGridTextColumn Header="OUT (FREQ.)" Binding="{Binding OutCount}" Width="1.1*" 
                                ElementStyle="{StaticResource CenterBoldColumnStyle}"/>

                            <DataGridTextColumn Header="IN (QTY)" Binding="{Binding TotalInQty}" Width="0.9*" 
                                ElementStyle="{StaticResource CenterBoldColumnStyle}"/>

                            <DataGridTextColumn Header="OUT (QTY)" Binding="{Binding TotalOutQty}" Width="1.0*" 
                                ElementStyle="{StaticResource CenterBoldColumnStyle}"/>

                            <DataGridTextColumn Header="INVENTORY BALANCE" Binding="{Binding FinalStock}" Width="1.8*" 
                                ElementStyle="{StaticResource SummaryStockStyle}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
            --><!-- End Function --><!--
        </Grid>
    </Border>
    --><!-- End Function --><!--
    
</Page>-->



    
    <!-- ใช้งานตัวนี้อยู่ -->
<!--<Page x:Class="CIMS.Views.ScanInView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
