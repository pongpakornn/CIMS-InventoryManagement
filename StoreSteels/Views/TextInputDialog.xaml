<Window x:Class="CIMS.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">

    <!-- ป็อปอัพกรอกข้อความบังคับ (เช่น เหตุผลการลบคลัง) - สไตล์เดียวกับ QuantityInputDialog -->
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="#212121" CornerRadius="20" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.6"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" CenterX="220" CenterY="120" ScaleX="0.8" ScaleY="0.8"/>
        </Border.RenderTransform>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Ellipse x:Name="StatusCircle" Width="60" Height="60" Fill="#0288D1" VerticalAlignment="Top"/>
                <TextBlock x:Name="lblIcon" Text="✎" FontSize="28" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,20,0,15">
                <TextBlock x:Name="lblTitle" Text="Title" Foreground="White" FontSize="20"
                           FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblMessage" Text="Message" Foreground="#AAAAAA"
                           FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="#2C2C2C" CornerRadius="10" Padding="8" Margin="0,0,0,20">
                <TextBox x:Name="txtInput" MinHeight="80" MaxLength="500" FontSize="14" FontWeight="SemiBold"
                         Foreground="White" Background="Transparent" BorderThickness="0" CaretBrush="White"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnConfirm" Content="CONFIRM" Style="{StaticResource DialogButton}"
                        Background="#0288D1" Click="Confirm_Click" Margin="5"/>
                <Button Content="CANCEL" Style="{StaticResource DialogButton}"
                        Background="#424242" Click="Cancel_Click" Margin="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
