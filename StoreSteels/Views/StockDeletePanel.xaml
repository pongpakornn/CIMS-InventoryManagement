<UserControl x:Class="CIMS.Views.StockDeletePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CIMS.Helpers"
             Loaded="Panel_Loaded">

    <!-- 🗑 STOCK DELETE (หน้าต่าง ADMIN): เลือกคลัง -> ลบรายการที่ติ๊กในตาราง หรือลบทั้งหมดในคลัง (ลบสินค้าออกจากระบบ แม้ยังมียอด) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="🗑 STOCK DELETE" FontSize="20" FontWeight="Black" Foreground="#B3261E"/>
            <TextBlock Text="Delete the ticked products, or every product of the chosen stock(s), from the whole system (all stocks, scan history, Max-Min and coils) - even if they still have stock."
                       Foreground="#8A8490" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,6">
            <TextBlock Text="1. SELECT STOCK" FontWeight="Black" FontSize="13" Foreground="#6750A4"/>
            <TextBlock Text="Only products that are in the selected stock(s) are deleted." FontSize="12" Foreground="#8A8490" FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icStocks">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- การ์ดคลังแบบเดียวกับหน้าต่างเลือกคลังของ Multi-Scanner: แถบสีด้านบน · วงกลม ✓ เมื่อเลือก · ป้ายจำนวนสินค้า -->
                        <Border x:Name="card" Width="230" Height="112" CornerRadius="18" Margin="0,0,14,14" Background="White" BorderBrush="#ECE9F1" BorderThickness="2"
                                Cursor="Hand" MouseLeftButtonUp="Card_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="bar" Grid.Row="0" CornerRadius="16,16,0,0" Background="#D9D2E6"/>
                                <Grid Grid.Row="1" Margin="16,10,12,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding Code}" FontSize="16" FontWeight="Black" Foreground="{StaticResource MainPurple}" TextTrimming="CharacterEllipsis" Margin="0,0,36,0"/>
                                        <Border x:Name="check" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="White" BorderBrush="#D9D2E6" BorderThickness="2">
                                            <TextBlock x:Name="checkMark" Text="" Foreground="White" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6B6770" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="8" Padding="8,3" Background="#FDECEA">
                                        <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="Black" Foreground="#B3261E"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#B3261E"/>
                                <Setter TargetName="card" Property="Background" Value="#FFF8F7"/>
                                <Setter TargetName="bar" Property="Background" Value="#B3261E"/>
                                <Setter TargetName="check" Property="Background" Value="#B3261E"/>
                                <Setter TargetName="check" Property="BorderBrush" Value="#B3261E"/>
                                <Setter TargetName="checkMark" Property="Text" Value="✓"/>
                            </DataTrigger>
                            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#E57373"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="2. WHAT TO DELETE" FontWeight="Black" FontSize="13" Foreground="#6750A4" Margin="0,0,0,6"/>
            <RadioButton x:Name="rbSelected" GroupName="delmode" FontWeight="Bold" Margin="0,0,0,4" Checked="Mode_Changed"/>
            <RadioButton x:Name="rbAll" GroupName="delmode" Content="DELETE ALL PRODUCTS IN THE SELECTED STOCK(S)" FontWeight="Bold" Checked="Mode_Changed"/>
            <TextBlock Text="3. REASON (required)" FontWeight="Black" FontSize="13" Foreground="#6750A4" Margin="0,12,0,6"/>
            <TextBox x:Name="txtReason" Height="42" Style="{StaticResource StkInput}" Tag="Why are these products being deleted?" TextChanged="Reason_Changed"/>
            <TextBlock x:Name="txtSummary" FontWeight="Bold" FontSize="13" Foreground="#B3261E" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnDelete" Content="🗑 DELETE" Style="{StaticResource StkButton}" Background="#C62828" Click="Delete_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</UserControl>
