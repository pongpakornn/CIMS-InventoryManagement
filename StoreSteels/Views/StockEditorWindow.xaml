<Window x:Class="CIMS.Views.StockEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Settings" Width="780" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- ตั้งค่าคลัง (เพิ่ม / แก้ไข): ชื่อ-รหัส-หน่วย, คอลัมน์ที่แสดง, ช่องทางรับเข้า/จ่ายออก, รูปแบบบาร์โค้ด Supplier -->

    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (ลากหน้าต่างได้) -->
            <Border Grid.Row="0" Background="{StaticResource MainPurple}" CornerRadius="21,21,0,0" Padding="26,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="txtTitle" Text="ADD STOCK" Foreground="White" FontSize="20" FontWeight="Black"/>
                    <TextBlock x:Name="txtSubtitle" Text="Create a new stock" Foreground="#D0BCFF" FontSize="12" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,20,26,6">
                <StackPanel>

                    <!-- 1) ข้อมูลคลัง -->
                    <Border Style="{StaticResource StkSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STOCK CODE" Style="{StaticResource StkLabel}"/>
                                <TextBox x:Name="txtCode" Style="{StaticResource StkInput}" MaxLength="30" Tag="e.g. Stock-OUT01"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STOCK NAME" Style="{StaticResource StkLabel}"/>
                                <TextBox x:Name="txtName" Style="{StaticResource StkInput}" MaxLength="100" Tag="e.g. Outside Warehouse"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="UNIT" Style="{StaticResource StkLabel}"/>
                                <ComboBox x:Name="cbUnit" Style="{StaticResource StkCombo}">
                                    <ComboBoxItem Content="KG"/>
                                    <ComboBoxItem Content="PCS"/>
                                    <ComboBoxItem Content="SHEET"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2) คอลัมน์ในตาราง -->
                    <Border Style="{StaticResource StkSection}">
                        <StackPanel>
                            <TextBlock Text="TABLE COLUMNS" Style="{StaticResource StkLabel}"/>
                            <WrapPanel>
                                <CheckBox x:Name="chkColNo" Content="NO." Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColImage" Content="IMAGE" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColCustomer" Content="CUSTOMER" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColCode" Content="PD CODE" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColPartA" Content="PART A" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColPartNo" Content="PART NO" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColModel" Content="MODEL" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColName" Content="PRODUCT NAME" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkMaxMin" Content="MAX / MIN" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColQty" Content="STOCK (UNIT)" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColStockBox" Content="STOCK (BOX)" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkCountCoil" Content="STOCK (COIL)" Style="{StaticResource StkChip}"/>
                                <!-- กด PD CODE แล้วแสดงแถว Coil ย่อย (ใช้ได้เมื่อเปิด STOCK (COIL)) - ไม่ใช่คอลัมน์ ไม่นับในลำดับคอลัมน์ -->
                                <CheckBox x:Name="chkCoilRows" Content="↳ COIL SUB ROWS" Style="{StaticResource StkChip}" IsChecked="True" IsEnabled="{Binding IsChecked, ElementName=chkCountCoil}" ToolTip="Click PD CODE in Store (Max-Min) to show the product's coils as sub rows"/>
                                <CheckBox x:Name="chkColStockPcs" Content="STOCK (PCS)" Style="{StaticResource StkChip}"/>
                                <CheckBox x:Name="chkColRemark" Content="REMARK" Style="{StaticResource StkChip}"/>
                            </WrapPanel>
                            <!-- ลำดับคอลัมน์ในตาราง = ลำดับที่ติ๊กเลือก -->
                            <TextBlock x:Name="txtColumnOrder" FontSize="12" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" Margin="2,2,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="Columns show in the order you tick them.  NO. = running number inside each group.  MAX / MIN also controls the STATUS column and the MAX Stock / MIN Stock filters.  STOCK (BOX) = STOCK / PACKSIZE.  STOCK (COIL) = coil count: scan IN +1, OUT -1, REMAINDER no coil."
                                       FontSize="11" Foreground="#8A8490" FontWeight="SemiBold" Margin="2,2,0,10" TextWrapping="Wrap"/>

                            <!-- 🧲 แถว Coil ย่อย (กด PD CODE): เลือกว่าแถวย่อยแสดงอะไรบ้าง - ใช้ได้เมื่อเปิด STOCK (COIL) + COIL SUB ROWS -->
                            <StackPanel x:Name="pnlCoilRowCols" Margin="0,0,0,10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=chkCountCoil}" Value="True"/>
                                                    <Condition Binding="{Binding IsChecked, ElementName=chkCoilRows}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="COIL SUB ROW COLUMNS" Style="{StaticResource StkLabel}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="chkSubCoilNo" Content="COIL NO." Tag="COILNO" Style="{StaticResource StkChip}" IsChecked="True"/>
                                    <CheckBox x:Name="chkSubMother" Content="MOTHER COIL" Tag="MOTHER" Style="{StaticResource StkChip}" IsChecked="True"/>
                                    <CheckBox x:Name="chkSubWeight" Content="WEIGHT (KG.)" Tag="WEIGHT" Style="{StaticResource StkChip}" IsChecked="True"/>
                                    <CheckBox x:Name="chkSubCoil" Content="STOCK (COIL)" Tag="COIL" Style="{StaticResource StkChip}" IsChecked="True"/>
                                    <CheckBox x:Name="chkSubTon" Content="WEIGHT (TON)" Tag="TON" Style="{StaticResource StkChip}" IsChecked="True"/>
                                    <CheckBox x:Name="chkSubReceived" Content="RECEIVED" Tag="RECEIVED" Style="{StaticResource StkChip}" IsChecked="True"/>
                                </WrapPanel>
                                <!-- ลำดับคอลัมน์ของแถว Coil = ลำดับที่ติ๊กเลือก (เหมือนคอลัมน์หลัก) -->
                                <TextBlock x:Name="txtSubOrder" FontSize="12" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" Margin="2,2,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Shown under the product when PD CODE is clicked. Untick and tick again to change the order: sub columns show left to right in the order you tick them. All ticked in the default order = lined up with the table (COIL NO. under PD CODE, MOTHER COIL under PRODUCT NAME, WEIGHT under STOCK, TON + RECEIVED under REMARK)."
                                           FontSize="11" Foreground="#8A8490" FontWeight="SemiBold" Margin="2,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GROUP TABLE BY" Style="{StaticResource StkLabel}"/>
                                    <ComboBox x:Name="cbGroupBy" Style="{StaticResource StkCombo}">
                                        <ComboBoxItem Content="CATEGORY"/>
                                        <ComboBoxItem Content="CUSTOMER"/>
                                        <ComboBoxItem Content="SUPPLIER"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAX / MIN UNIT" Style="{StaticResource StkLabel}"/>
                                    <ComboBox x:Name="cbMaxMinBasis" Style="{StaticResource StkCombo}">
                                        <ComboBoxItem Content="KG"/>
                                        <ComboBoxItem Content="PCS"/>
                                        <ComboBoxItem Content="SHEET"/>
                                        <ComboBoxItem Content="BOX"/>
                                        <ComboBoxItem Content="COIL"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <!-- 🔢 เก็บ / แสดงยอดเป็นทศนิยม (เช่น KG) - ปิด = จำนวนเต็มเหมือนเดิม -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="chkAllowDecimal" Content="DECIMAL QTY" Style="{StaticResource StkChip}" VerticalAlignment="Center"/>
                                <TextBlock Text="Keep decimals in QTY / MAX / MIN and scans (e.g. 1,234.50 KG). Off = whole numbers."
                                           FontSize="11" FontWeight="SemiBold" Foreground="#8A8490" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- 🔢 MAX / MIN แสดง / เก็บทศนิยมหรือไม่ (แยกจาก DECIMAL QTY) -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="chkMaxMinDecimal" Content="MAX / MIN DECIMAL" Style="{StaticResource StkChip}" VerticalAlignment="Center"/>
                                <TextBlock Text="MAX / MIN with decimals (e.g. 5.50). Off = whole numbers (e.g. 6), even when DECIMAL QTY is on."
                                           FontSize="11" FontWeight="SemiBold" Foreground="#8A8490" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- 🃏 การ์ดสินค้าเหนือตาราง: มีรูป / ไม่มีรูป / ปิด (คลังที่ไม่มีรูปก็มีการ์ดได้) -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PRODUCT CARDS" Style="{StaticResource StkLabel}"/>
                                    <ComboBox x:Name="cbCardStyle" Style="{StaticResource StkCombo}" SelectionChanged="cbCardStyle_SelectionChanged">
                                        <ComboBoxItem Content="WITH IMAGE" Tag="IMAGE"/>
                                        <ComboBoxItem Content="NO IMAGE" Tag="TEXT"/>
                                        <ComboBoxItem Content="OFF" Tag="OFF"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="txtCardHint" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#8A8490" VerticalAlignment="Bottom" Margin="14,0,0,8" TextWrapping="Wrap"
                                           Text="Cards that scroll above the table (switch SHOW CARDS on the Store page). WITH IMAGE = product picture + details. NO IMAGE = big part number and big stock numbers, for stocks without pictures."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3) ช่องทางรับเข้า / จ่ายออก -->
                    <Border Style="{StaticResource StkSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECEIVE ( IN )" Style="{StaticResource StkLabel}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="chkInPickList" Content="PICK LIST QR" Style="{StaticResource StkChip}"/>
                                    <CheckBox x:Name="chkInSupplier" Content="SUPPLIER LABEL" Style="{StaticResource StkChip}" Checked="Channel_Changed" Unchecked="Channel_Changed"/>
                                    <CheckBox x:Name="chkInSysQr" Content="SYSTEM QR" Style="{StaticResource StkChip}"/>
                                    <CheckBox x:Name="chkInExcel" Content="IMPORT EXCEL" Style="{StaticResource StkChip}"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ISSUE ( OUT )" Style="{StaticResource StkLabel}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="chkOutPickList" Content="PICK LIST QR" Style="{StaticResource StkChip}"/>
                                    <CheckBox x:Name="chkOutSupplier" Content="SUPPLIER LABEL" Style="{StaticResource StkChip}" Checked="Channel_Changed" Unchecked="Channel_Changed"/>
                                    <CheckBox x:Name="chkOutSysQr" Content="SYSTEM QR" Style="{StaticResource StkChip}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4) รูปแบบป้าย Supplier ที่คลังนี้รับ -->
                    <Border x:Name="pnlFormats" Style="{StaticResource StkSection}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="SUPPLIER LABEL FORMATS" Style="{StaticResource StkLabel}" VerticalAlignment="Center"/>
                                <Button x:Name="btnManageFormats" Content="🏷 MANAGE FORMATS" Style="{StaticResource StkCardButton}"
                                        HorizontalAlignment="Right" Click="ManageFormats_Click"/>
                            </Grid>
                            <WrapPanel x:Name="wpFormats" Margin="0,6,0,0"/>
                            <TextBlock x:Name="txtNoFormats" Text="No barcode format yet - click MANAGE FORMATS to add one."
                                       FontSize="11" Foreground="#8A8490" FontWeight="SemiBold" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,6,26,22">
                <Button Content="CANCEL" Style="{StaticResource StkButton}" Background="#9E9E9E" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="btnSave" Content="SAVE" Style="{StaticResource StkButton}" Background="{StaticResource AccentPurple}" MinWidth="140" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
