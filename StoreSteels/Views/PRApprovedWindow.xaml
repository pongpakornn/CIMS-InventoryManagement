<Window x:Class="CIMS.Views.PRApprovedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approved PR" Width="1400" Height="840"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <!-- 📋 รายการ PR ที่ Approve แล้ว: ค้นหาแบบพิมพ์แล้วขึ้นทันที / ช่วงวันที่ / ติ๊กเลือกแล้ว EXPORT / EDIT - DEL -->
    <Border Background="White" CornerRadius="22" Margin="18" BorderBrush="#ECE9F1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#2E7D32" CornerRadius="21,21,0,0" Padding="26,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="📋 APPROVED PR LIST" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="Search, pick a date range, tick the items and export / edit / delete" Foreground="#C8E6C9" FontSize="12" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StkCardButton}" Click="Close_Click" ToolTip="CLOSE"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Style="{StaticResource StkInput}" Height="42" Tag="Search PR No, product, code, requester, department, remark..." TextChanged="Search_Changed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="FROM" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpFrom" Width="150" SelectedDateChanged="Date_Changed"/>
                    <TextBlock Text="TO" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <DatePicker x:Name="dpTo" Width="150" SelectedDateChanged="Date_Changed"/>
                    <Button x:Name="btnExport" Content="📤 EXPORT" Style="{StaticResource StkButton}" Background="#1976D2" Margin="12,0,0,0" Click="Export_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgApproved" Grid.Row="2" Margin="24,0,24,0"
                      AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="Transparent" BorderThickness="0" RowHeight="48" FontSize="13" FontWeight="SemiBold"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F2F0F5" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <Style x:Key="Cell" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="54">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="chkAll" HorizontalAlignment="Center" Click="SelectAll_Click" ToolTip="Select all"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Row_Checked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PR NO" Binding="{Binding PR_NO}" Width="1.1*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="APPROVED" Binding="{Binding AppDateDisplay}" Width="1.1*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="REQUESTER" Binding="{Binding Requester}" Width="1*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="1.3*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="PRODUCT CODE" Binding="{Binding PartCode}" Width="1.3*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding PartName}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding QTY, StringFormat=N0}" Width="0.6*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="REMARK" Binding="{Binding PR_REM}" Width="1.3*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTextColumn Header="EXPORTED" Binding="{Binding ExportDisplay}" Width="1.1*" IsReadOnly="True" ElementStyle="{StaticResource Cell}"/>
                    <DataGridTemplateColumn Header="ACTION" Width="168">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="EDIT" Width="68" MinWidth="0" Height="30" FontSize="11" Margin="0,0,6,0" Padding="0" HorizontalContentAlignment="Center" Style="{StaticResource StkButton}" Background="#1976D2" Click="Edit_Click" Visibility="{Binding EditVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="DEL" Width="68" MinWidth="0" Height="30" FontSize="11" Padding="0" HorizontalContentAlignment="Center" Style="{StaticResource StkButton}" Background="#C62828" Click="Delete_Click" Visibility="{Binding DeleteVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="txtEmpty" Grid.Row="2" Text="NO APPROVED PR" FontSize="15" FontWeight="Bold" Foreground="#AAA"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <Grid Grid.Row="3" Margin="24,10,24,18">
                <TextBlock x:Name="txtStatus" FontSize="12" FontWeight="Bold" Foreground="#8A8490" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
