<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.1" />
  </ItemGroup>

  <!--
      All XAML in this project references icons/gifs via pack URIs (e.g. "/Assets/Icons/x.png"),
      which requires each file to have WPF's "Resource" build action - the SDK does not apply this
      by default. Visual Studio was adding per-file <Resource Include> entries locally each session
      but that was never committed, so a plain `dotnet build`/checkout never had the assets embedded
      and every pack URI failed at runtime with "Cannot locate resource" as soon as a page referencing
      one loaded (e.g. MainView right after login). One wildcard covers every current and future file
      under Assets/ so this can't silently regress again.
  -->
  <ItemGroup>
    <Resource Include="Assets\**\*.png;Assets\**\*.gif;Assets\**\*.ico" />
  </ItemGroup>

  <!--
      PackingCard.lbx is a Brother b-PAC label template, opened at runtime via a real file path
      (bpac.Document.Open() takes a filesystem path/URL, not a pack-URI resource stream), so it
      ships as plain Content copied next to the exe rather than an embedded WPF Resource.
  -->
  <ItemGroup>
    <None Include="Assets\Labels\PackingCard.lbx" Condition="Exists('Assets\Labels\PackingCard.lbx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Excel templates (Max-MinCal export/import format) copied next to the exe and read at runtime -->
  <ItemGroup>
    <None Update="Templates\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
      Interop assembly for the Brother b-PAC 3.4 Type Library (bpac.dll), used by
      Services/PackingCardPrintService.cs to print Packing Card labels through Brother's official
      label-printing COM API instead of the WPF PrintDialog/PrintVisual + PrintTicket.PageMediaSize
      path, which the QL-800 driver rejects as an unrecognized preset and warns about on every print.

      This is a plain assembly reference (Libs\Interop.bpac.dll) rather than a <COMReference>: the
      SDK-style `dotnet build`/CLI MSBuild does not support the ResolveComReference task at all
      ("MSB4803: not supported on the .NET Core version of MSBuild") - only Visual Studio's bundled
      Full Framework MSBuild does - so a <COMReference> here would build in the IDE but fail on any
      CLI/CI build. Libs\Interop.bpac.dll was pre-generated once with the Windows SDK's TlbImp.exe
      against this machine's registered bpac.dll (see setup steps in PackingCardPrintService.cs) and
      is committed to the repo so no machine-specific COM interop generation step is needed to build.
  -->
  <ItemGroup>
    <Reference Include="Interop.bpac">
      <HintPath>Libs\Interop.bpac.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
